namespace(configuration) {
	namespace(toClient) {
		updated(packet) {
			converted(registry_data, up: custom(late_registry_data_up_26_1), down: custom(late_registry_data_down_1_21_11));
			converted(finish_configuration, up: custom(late_finish_configuration_up_26_1));
			converted(tags, up: custom(late_config_tags_up_26_1), down: custom(late_config_tags_down_1_21_11));
		};
	};
};

namespace(play) {
	namespace(toClient) {
		updated(SlotDisplay) {
			added(dyed_slot_demo, down: drop);
			added(only_with_component, down: drop);
			added(with_any_potion, down: drop);
			converted(item, up: custom(late_display_item_up_26_1), down: custom(late_display_item_down_1_21_11));
			converted(item_stack, up: custom(late_display_stack_up_26_1), down: custom(late_display_stack_down_1_21_11));
		};

		updated(packet) {
			added(game_rule_values, down: drop);
			added(low_disk_space_warning, down: drop);
			converted(open_book, up: custom(late_open_book_up_26_1), down: custom(late_open_book_down_1_21_11));
			converted(statistics, up: custom(late_statistics_up_26_1), down: custom(late_statistics_down_1_21_11));
			converted(tags, up: custom(late_play_tags_up_26_1), down: custom(late_play_tags_down_1_21_11));
		};

		updated(packet_advancements) {
			updated(advancementMapping) {
				updated(items) {
					updated(value) {
						updated(displayData) {
							updated(value) {
								converted(icon, up: custom(late_icon_up_26_1), down: custom(late_icon_down_1_21_11));
							};
						};
					};
				};
			};
		};

		updated(packet_update_time) {
			added(clockUpdates, up: custom(late_update_time_up_26_1));
			removed(tickDayTime, down: custom(late_tick_day_time_down_1_21_11));
			removed(time, down: custom(late_day_time_down_1_21_11));
		};

		updated(packet_entity_metadata) {
			converted(entityId, up: custom(late_meta_entity_up_26_1), down: custom(late_meta_entity_down_1_21_11));
		};

		updated(packet_map_chunk) {
			converted(chunkData, up: custom(late_chunk_up_26_1), down: custom(late_chunk_down_1_21_11));
		};

		updated(packet_block_change) {
			converted(type, up: custom(late_block_change_up_26_1), down: custom(late_block_change_down_1_21_11));
		};

		updated(packet_multi_block_change) {
			converted(records, up: custom(late_multi_block_up_26_1), down: custom(late_multi_block_down_1_21_11));
		};

		updated(packet_block_action) {
			converted(blockId, up: custom(late_block_action_up_26_1), down: custom(late_block_action_down_1_21_11));
		};

		updated(packet_world_event) {
			converted(data, up: custom(late_world_event_up_26_1), down: custom(late_world_event_down_1_21_11));
		};

		updated(packet_declare_recipes) {
			updated(recipes) {
				updated(items) {
					converted(items, up: custom(late_recipe_items_up_26_1), down: custom(late_recipe_items_down_1_21_11));
				};
			};
			updated(stoneCutterRecipes) {
				updated(items) {
					converted(input, up: custom(late_stonecutter_up_26_1), down: custom(late_stonecutter_down_1_21_11));
				};
			};
		};

		updated(packet_recipe_book_add) {
			updated(entries) {
				updated(items) {
					updated(recipe) {
						converted(craftingRequirements, up: custom(late_requirements_up_26_1), down: custom(late_requirements_down_1_21_11));
					};
				};
			};
		};

		updated(packet_trade_list) {
			updated(trades) {
				updated(items) {
					updated(inputItem1) {
						converted(itemId, up: custom(late_trade1_up_26_1), down: custom(late_trade1_down_1_21_11));
					};
					updated(inputItem2) {
						updated(value) {
							converted(itemId, up: custom(late_trade2_up_26_1), down: custom(late_trade2_down_1_21_11));
						};
					};
				};
			};
		};
	};
};

