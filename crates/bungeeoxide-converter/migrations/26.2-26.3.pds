};

updated(command_node) {
	updated(extraNodeData) {
		updated(v2) {
			updated(properties) {
				added(minecraft_context_float_provider, down: minecraft_nbt_tag);
				added(minecraft_context_int_provider, down: minecraft_nbt_tag);
				added(minecraft_feature, down: minecraft_resource_location);
				added(minecraft_slot_source, down: minecraft_nbt_tag);
				added(minecraft_swing_animation, down: minecraft_resource_location);
			};
		};
	};
};

updated(entityMetadataEntry) {
	updated(value) {
		added(dye_color, down: drop);
		renamed(optional_uuid, to: optional_living_entity_reference);
		converted(block_state, up: custom(late_meta_state_up_26_3), down: custom(late_meta_state_down_26_2));
		converted(optional_block_state, up: custom(late_meta_optional_state_up_26_3), down: custom(late_meta_optional_state_down_26_2));
	};
};

namespace(configuration) {
	namespace(toClient) {
		updated(packet) {
			added(post_effects, down: drop);
			converted(registry_data, up: custom(late_registry_data_up_26_3), down: custom(late_registry_data_down_26_2));
			converted(finish_configuration, up: custom(late_finish_configuration_up_26_3));
			converted(tags, up: custom(late_config_tags_up_26_3), down: custom(late_config_tags_down_26_2));
		};
	};
};

namespace(play) {
	namespace(toClient) {
		updated(SlotDisplay) {
			converted(tag, up: custom(late_display_tag_up_26_3), down: custom(late_display_tag_down_26_2));
			converted(item, up: custom(late_display_item_up_26_3), down: custom(late_display_item_down_26_2));
		};

		updated(SpawnInfo) {
			converted(previousGamemode, up: custom(late_previous_gamemode_up_26_3), down: custom(late_previous_gamemode_down_26_2));
		};

		updated(packet) {
			added(add_transient_block, down: drop);
			added(post_effects, down: drop);
			added(swing_animation, down: custom(late_swing_down_26_2));
			converted(animation, up: custom(late_animation_up_26_3), down: custom(late_animation_down_26_2));
			converted(rel_entity_move, up: custom(late_rel_move_up_26_3), down: custom(late_rel_move_down_26_2));
			converted(entity_move_look, up: custom(late_move_look_up_26_3), down: custom(late_move_look_down_26_2));
			converted(sync_entity_position, up: custom(late_sync_position_up_26_3), down: custom(late_sync_position_down_26_2));
			converted(world_event, up: custom(late_world_event_up_26_3), down: custom(late_world_event_down_26_2));
			converted(statistics, up: custom(late_statistics_up_26_3), down: custom(late_statistics_down_26_2));
			converted(tags, up: custom(late_play_tags_up_26_3), down: custom(late_play_tags_down_26_2));
		};

		updated(packet_advancements) {
			updated(advancementMapping) {
				updated(items) {
					converted(key, down: custom(late_advancement_key_down_26_2));
					added(x, up: custom(late_advancement_x_up_26_3));
					added(y, up: custom(late_advancement_y_up_26_3));
					updated(value) {
						updated(displayData) {
							updated(value) {
								removed(xCord, down: custom(late_advancement_x_down_26_2));
								removed(yCord, down: custom(late_advancement_y_down_26_2));
							};
						};
					};
				};
			};
		};

		updated(packet_explosion) {
			added(playSound, up: true);
		};

		updated(packet_map_chunk) {
			updated(skyLightMask, up: custom(late_mask_up_26_3), down: custom(late_mask_down_26_2));
			updated(blockLightMask, up: custom(late_mask_up_26_3), down: custom(late_mask_down_26_2));
			updated(emptySkyLightMask, up: custom(late_mask_up_26_3), down: custom(late_mask_down_26_2));
			updated(emptyBlockLightMask, up: custom(late_mask_up_26_3), down: custom(late_mask_down_26_2));
			converted(chunkData, up: custom(late_chunk_up_26_3), down: custom(late_chunk_down_26_2));
		};

		updated(packet_update_light) {
			updated(skyLightMask, up: custom(late_mask_up_26_3), down: custom(late_mask_down_26_2));
			updated(blockLightMask, up: custom(late_mask_up_26_3), down: custom(late_mask_down_26_2));
			updated(emptySkyLightMask, up: custom(late_mask_up_26_3), down: custom(late_mask_down_26_2));
			updated(emptyBlockLightMask, up: custom(late_mask_up_26_3), down: custom(late_mask_down_26_2));
		};

		updated(packet_player_chat) {
			updated(filterTypeMask) {
				updated(v2, up: custom(late_mask_up_26_3), down: custom(late_mask_down_26_2));
			};
		};

		updated(packet_world_particles) {
			converted(amount);
			added(xMaxSpeed, up: ./velocityOffset);
			added(yMaxSpeed, up: ./velocityOffset);
			added(zMaxSpeed, up: ./velocityOffset);
			removed(velocityOffset, down: ./xMaxSpeed);
			added(randomizationType, up: custom(late_randomization_up_26_3));
		};

		updated(packet_spawn_entity) {
			converted(type, up: custom(late_spawn_type_up_26_3), down: custom(late_spawn_type_down_26_2));
			converted(objectData, up: custom(late_object_data_up_26_3), down: custom(late_object_data_down_26_2));
		};

		updated(packet_block_change) {
			converted(type, up: custom(late_block_change_up_26_3), down: custom(late_block_change_down_26_2));
		};

		updated(packet_multi_block_change) {
			converted(records, up: custom(late_multi_block_up_26_3), down: custom(late_multi_block_down_26_2));
		};

		updated(packet_block_action) {
			converted(blockId, up: custom(late_block_action_up_26_3), down: custom(late_block_action_down_26_2));
		};

		updated(packet_declare_recipes) {
			converted(recipes, up: custom(late_recipe_sets_up_26_3), down: custom(late_recipe_sets_down_26_2));
			updated(stoneCutterRecipes) {
				updated(items) {
					converted(input, up: custom(late_stonecutter_up_26_3), down: custom(late_stonecutter_down_26_2));
				};
			};
		};

		updated(packet_recipe_book_add) {
			updated(entries) {
				updated(items) {
					updated(recipe) {
						converted(craftingRequirements, up: custom(late_requirements_up_26_3), down: custom(late_requirements_down_26_2));
					};
				};
			};
		};

		updated(packet_trade_list) {
			updated(trades) {
				updated(items) {
					updated(inputItem1) {
						converted(itemId, up: custom(late_trade1_up_26_3), down: custom(late_trade1_down_26_2));
					};
					updated(inputItem2) {
						updated(value) {
							converted(itemId, up: custom(late_trade2_up_26_3), down: custom(late_trade2_down_26_2));
						};
					};
				};
			};
		};
	};
};

namespace(play) {
	namespace(toServer) {
		updated(packet) {
			removed(arm_animation, up: custom(late_arm_animation_up_26_3));
			added(punch, down: custom(late_punch_down_26_2));
			converted(teleport_confirm, up: custom(late_teleport_confirm_up_26_3), down: custom(late_teleport_confirm_down_26_2));
			converted(position_look, up: custom(late_position_look_up_26_3));
			converted(position, up: custom(late_position_up_26_3));
			converted(tick_end, up: custom(late_tick_end_up_26_3));
		};

		updated(packet_block_dig) {
			converted(status, up: custom(late_dig_status_up_26_3), down: custom(late_dig_status_down_26_2));
		};
	};
};
