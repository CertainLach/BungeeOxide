updated(Slot) {
	updated(default) {
		converted(itemId, up: custom(late_slot_item_up_26_3), down: custom(late_slot_item_down_26_2));
		converted(addedComponentCount, up: custom(late_added_count_up_26_3), down: custom(late_added_count_down_26_2));
		converted(removedComponentCount, up: custom(late_removed_count_up_26_3), down: custom(late_removed_count_down_26_2));
	};
};

updated(ItemStackTemplate) {
	converted(itemId, up: custom(late_template_item_up_26_3), down: custom(late_template_item_down_26_2));
	converted(addedComponentCount, up: custom(late_template_added_up_26_3), down: custom(late_template_added_down_26_2));
	converted(removedComponentCount, up: custom(late_template_removed_up_26_3), down: custom(late_template_removed_down_26_2));
};

updated(HashedSlot) {
	converted(itemId, up: custom(late_hashed_item_up_26_3), down: custom(late_hashed_item_down_26_2));
};

updated(UntrustedSlot, up: custom(late_untrusted_up_26_3), down: custom(late_untrusted_down_26_2));

updated(ItemSoundHolder, up: custom(late_sound_up_26_3), down: custom(late_sound_down_26_2));

updated(ItemBlockPredicate) {
	converted(blockSet, up: custom(late_predicate_up_26_3), down: custom(late_predicate_down_26_2));
	converted(components, up: custom(late_matchers_up_26_3), down: custom(late_matchers_down_26_2));
};

updated(ArmorTrimMaterial) {
	removed(assetBase, down: custom(late_trim_asset_down_26_2));
	removed(overrideArmorAssets, down: custom(late_trim_overrides_down_26_2));
	added(paletteId, up: custom(late_trim_palette_up_26_3));
};

updated(InstrumentData) {
	added(durabilityDamage, up: 0);
};

updated(ItemConsumeEffect) {
	converted(teleport_randomly, up: custom(late_teleport_effect_up_26_3), down: custom(late_teleport_effect_down_26_2));
};

updated(Particle) {
	added(red_poplar_leaves, down: custom(late_particle_red_poplar_down_26_2));
	added(orange_poplar_leaves, down: custom(late_particle_orange_poplar_down_26_2));
	added(yellow_poplar_leaves, down: custom(late_particle_yellow_poplar_down_26_2));
	renamed(trial_spawner_detected_player, to: trial_spawner_detection);
	renamed(trial_spawner_detected_player_ominous, to: trial_spawner_detection_ominous);
	converted(block, up: custom(late_particle_block_up_26_3), down: custom(late_particle_block_down_26_2));
	converted(block_marker, up: custom(late_particle_marker_up_26_3), down: custom(late_particle_marker_down_26_2));
	converted(falling_dust, up: custom(late_particle_dust_up_26_3), down: custom(late_particle_dust_down_26_2));
	converted(dust_pillar, up: custom(late_particle_pillar_up_26_3), down: custom(late_particle_pillar_down_26_2));
	converted(block_crumble, up: custom(late_particle_crumble_up_26_3), down: custom(late_particle_crumble_down_26_2));
};

updated(SlotComponent) {
	added(attack_animation, down: custom(late_attack_animation_down_26_2));
	added(interact_animation, down: drop);
	removed(swing_animation, up: custom(late_swing_animation_up_26_3));
	removed(map_color, up: drop);
	added(block_transformer, down: drop);
	added(brewing_fuel, down: drop);
	added(compostable, down: drop);
	added(cooking_fuel, down: drop);
	added(cushion_color, down: drop);
	added(mob_visibility, down: drop);
	added(provides_pottery_pattern, down: drop);
	added(sign_text_back, down: drop);
	added(sign_text_front, down: drop);
	added(villager_food, down: drop);
	added(waxed, down: drop);
	converted(pot_decorations, up: custom(late_pots_up_26_3), down: custom(late_pots_down_26_2));
	updated(equippable) {
		converted(allowedEntities, up: custom(late_equip_entities_up_26_3), down: custom(late_equip_entities_down_26_2));
	};
	updated(tool) {
		updated(rules) {
			updated(items) {
				converted(blocks, up: custom(late_tool_up_26_3), down: custom(late_tool_down_26_2));
			};
		};
	};
	converted(repairable, up: custom(late_repairable_up_26_3), down: custom(late_repairable_down_26_2));
	updated(tooltip_display) {
		converted(hiddenComponents, up: custom(late_hidden_up_26_3), down: custom(late_hidden_down_26_2));
	};
};

updated(SlotComponentType) {
	added(attack_animation, down: custom(late_attack_animation_type_down_26_2));
	added(interact_animation, down: drop);
	removed(swing_animation, up: custom(late_swing_animation_type_up_26_3));
	removed(map_color, up: drop);
	added(block_transformer, down: drop);
	added(brewing_fuel, down: drop);
	added(compostable, down: drop);
	added(cooking_fuel, down: drop);
	added(cushion_color, down: drop);
	added(mob_visibility, down: drop);
	added(provides_pottery_pattern, down: drop);
	added(sign_text_back, down: drop);
	added(sign_text_front, down: drop);
	added(villager_food, down: drop);
