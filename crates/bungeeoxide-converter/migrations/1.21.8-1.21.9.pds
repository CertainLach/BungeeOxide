};

namespace(play) {
	namespace(toClient) {
		updated(SlotDisplay) {
			converted(item, up: custom(late_display_item_up_1_21_9), down: custom(late_display_item_down_1_21_8));
		};

		updated(SpawnInfo) {
			converted(name, up: custom(late_spawn_info_up_1_21_9), down: custom(late_spawn_info_down_1_21_8));
		};

		updated(packet) {
			added(debug_block_value, down: drop);
			added(debug_chunk_value, down: drop);
			added(debug_entity_value, down: drop);
			added(debug_event, down: drop);
			added(game_test_highlight_pos, down: drop);
			converted(action_bar, down: custom(late_action_bar_down_1_21_8));
			converted(set_title_text, down: custom(late_title_down_1_21_8));
			converted(set_title_subtitle, down: custom(late_subtitle_down_1_21_8));
			converted(kick_disconnect, down: custom(late_kick_down_1_21_8));
			converted(server_links, down: custom(late_links_down_1_21_8));
			converted(spawn_position, up: custom(late_spawn_position_up_1_21_9), down: custom(late_spawn_position_down_1_21_8));
			converted(statistics, up: custom(late_statistics_up_1_21_9), down: custom(late_statistics_down_1_21_8));
			converted(tags, up: custom(late_play_tags_up_1_21_9), down: custom(late_play_tags_down_1_21_8));
		};

		updated(packet_explosion) {
			added(center, up: (x: ./x, y: ./y, z: ./z));
			added(radius, up: 0.0);
			added(blockCount, up: 0);
			added(blockParticles, up: []);
			removed(x, down: ./center/x);
			removed(y, down: ./center/y);
			removed(z, down: ./center/z);
		};

		updated(packet_move_minecart) {
			updated(steps) {
				updated(items) {
					renamed(movement, to: velocity);
				};
			};
		};

		updated(packet_player_rotation, up: custom(late_rotation_up_1_21_9), down: custom(late_rotation_down_1_21_8));

		updated(packet_system_chat, down: custom(late_system_chat_down_1_21_8));

		updated(packet_playerlist_header, down: custom(late_header_down_1_21_8));

		updated(packet_death_combat_event, down: custom(late_death_down_1_21_8));

		updated(packet_profileless_chat, down: custom(late_profileless_down_1_21_8));

		updated(packet_scoreboard_objective, down: custom(late_objective_down_1_21_8));

		updated(packet_scoreboard_score, down: custom(late_score_down_1_21_8));

		updated(packet_boss_bar, down: custom(late_boss_bar_down_1_21_8));

		updated(packet_map, down: custom(late_map_down_1_21_8));

		updated(packet_tab_complete, down: custom(late_tab_complete_down_1_21_8));

		updated(packet_server_data, down: custom(late_server_data_down_1_21_8));

		updated(packet_open_window, down: custom(late_open_window_down_1_21_8));

		updated(packet_player_chat, down: custom(late_player_chat_down_1_21_8));

		updated(packet_advancements) {
			updated(advancementMapping) {
				updated(items) {
					updated(value) {
						updated(displayData) {
							updated(value) {
								updated(title, up: custom(late_text_keep_up_1_21_9), down: custom(late_unobject_down_1_21_8));
								updated(description, up: custom(late_text_keep_up_1_21_9), down: custom(late_unobject_down_1_21_8));
							};
						};
					};
				};
			};
		};

		updated(packet_spawn_entity) {
			converted(type, up: custom(late_spawn_type_up_1_21_9), down: custom(late_spawn_type_down_1_21_8));
			converted(objectData, up: custom(late_object_data_up_1_21_9), down: custom(late_object_data_down_1_21_8));
			converted(velocity, up: custom(late_spawn_velocity_up_1_21_9), down: custom(late_spawn_velocity_down_1_21_8));
		};

		updated(packet_entity_velocity) {
			converted(velocity, up: custom(late_velocity_up_1_21_9), down: custom(late_velocity_down_1_21_8));
		};

		updated(packet_entity_metadata) {
			converted(entityId, up: custom(late_meta_entity_up_1_21_9), down: custom(late_meta_entity_down_1_21_8));
		};

		updated(packet_tile_entity_data) {
			converted(action, up: custom(late_tile_entity_up_1_21_9), down: custom(late_tile_entity_down_1_21_8));
		};

		updated(packet_initialize_world_border) {
			converted(x, up: custom(late_border_x_up_1_21_9), down: custom(late_border_x_down_1_21_8));
			converted(z, up: custom(late_border_z_up_1_21_9), down: custom(late_border_z_down_1_21_8));
		};

		updated(packet_world_border_center) {
			converted(x, up: custom(late_border_center_x_up_1_21_9), down: custom(late_border_center_x_down_1_21_8));
			converted(z, up: custom(late_border_center_z_up_1_21_9), down: custom(late_border_center_z_down_1_21_8));
		};

		updated(packet_map_chunk) {
			converted(chunkData, up: custom(late_chunk_up_1_21_9), down: custom(late_chunk_down_1_21_8));
		};

		updated(packet_block_change) {
			converted(type, up: custom(late_block_change_up_1_21_9), down: custom(late_block_change_down_1_21_8));
		};

		updated(packet_multi_block_change) {
			converted(records, up: custom(late_multi_block_up_1_21_9), down: custom(late_multi_block_down_1_21_8));
		};

		updated(packet_block_action) {
			converted(blockId, up: custom(late_block_action_up_1_21_9), down: custom(late_block_action_down_1_21_8));
		};

		updated(packet_world_event) {
			converted(data, up: custom(late_world_event_up_1_21_9), down: custom(late_world_event_down_1_21_8));
		};

		updated(packet_declare_recipes) {
			updated(recipes) {
				updated(items) {
					converted(items, up: custom(late_recipe_items_up_1_21_9), down: custom(late_recipe_items_down_1_21_8));
				};
			};
			updated(stoneCutterRecipes) {
				updated(items) {
					converted(input, up: custom(late_stonecutter_up_1_21_9), down: custom(late_stonecutter_down_1_21_8));
				};
			};
		};

		updated(packet_recipe_book_add) {
			updated(entries) {
				updated(items) {
					updated(recipe) {
						converted(craftingRequirements, up: custom(late_requirements_up_1_21_9), down: custom(late_requirements_down_1_21_8));
					};
				};
			};
		};

		updated(packet_trade_list) {
			updated(trades) {
				updated(items) {
					updated(inputItem1) {
						converted(itemId, up: custom(late_trade1_up_1_21_9), down: custom(late_trade1_down_1_21_8));
					};
					updated(inputItem2) {
						updated(value) {
							converted(itemId, up: custom(late_trade2_up_1_21_9), down: custom(late_trade2_down_1_21_8));
						};
					};
				};
			};
		};
	};
};

