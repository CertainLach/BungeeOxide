updated(Particle) {
	added(copper_fire_flame, down: soul_fire_flame);
	converted(dragon_breath, up: custom(late_particle_dragon_breath_up_1_21_9), down: custom(late_particle_dragon_breath_down_1_21_8));
	converted(effect, up: custom(late_particle_effect_up_1_21_9), down: custom(late_particle_effect_down_1_21_8));
	converted(flash, up: custom(late_particle_flash_up_1_21_9), down: custom(late_particle_flash_down_1_21_8));
	converted(instant_effect, up: custom(late_particle_instant_effect_up_1_21_9), down: custom(late_particle_instant_effect_down_1_21_8));
	converted(block, up: custom(late_particle_block_up_1_21_9), down: custom(late_particle_block_down_1_21_8));
	converted(block_marker, up: custom(late_particle_marker_up_1_21_9), down: custom(late_particle_marker_down_1_21_8));
	converted(falling_dust, up: custom(late_particle_dust_up_1_21_9), down: custom(late_particle_dust_down_1_21_8));
