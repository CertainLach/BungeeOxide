updated(SlotComponent) {
	converted(block_entity_data, up: custom(late_block_entity_data_up_1_21_9), down: custom(late_block_entity_data_down_1_21_8));
	converted(entity_data, up: custom(late_entity_data_up_1_21_9), down: custom(late_entity_data_down_1_21_8));
	converted(profile, up: custom(late_profile_up_1_21_9), down: custom(late_profile_down_1_21_8));
	updated(bees) {
		updated(items) {
			added(type, up: custom(late_bee_type_up_1_21_9));
		};
	};
	updated(lodestone_tracker) {
		updated(globalPosition) {
			updated(value) {
				renamed(dimension, to: dimensionName);
				renamed(position, to: location);
			};
		};
	};
	updated(equippable) {
		converted(allowedEntities, up: custom(late_equip_entities_up_1_21_9), down: custom(late_equip_entities_down_1_21_8));
	};
	updated(tool) {
		updated(rules) {
			updated(items) {
				converted(blocks, up: custom(late_tool_up_1_21_9), down: custom(late_tool_down_1_21_8));
			};
		};
	};
	converted(repairable, up: custom(late_repairable_up_1_21_9), down: custom(late_repairable_down_1_21_8));
	converted(pot_decorations, up: custom(late_pots_up_1_21_9), down: custom(late_pots_down_1_21_8));
};

updated(entityMetadataEntry) {
	converted(key, up: custom(late_meta_key_up_1_21_9), down: custom(late_meta_key_down_1_21_8));
	updated(value) {
		removed(compound_tag, up: custom(late_meta_compound_up_1_21_9));
		added(copper_golem_state, down: drop);
		added(resolvable_profile, down: drop);
		added(weathering_copper_golem_state, down: drop);
		converted(optional_unsigned_int, down: custom(late_meta_unsigned_down_1_21_8));
		converted(block_state, up: custom(late_meta_state_up_1_21_9), down: custom(late_meta_state_down_1_21_8));
		converted(optional_block_state, up: custom(late_meta_optional_state_up_1_21_9), down: custom(late_meta_optional_state_down_1_21_8));
	};
};

