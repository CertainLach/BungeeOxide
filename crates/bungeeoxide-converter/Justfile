mcdata := "../../target/minecraft-data"
languages := "../../target/minecraft-languages"
pds2 := "pds2"
crates := "../../minecraft"
split := "--crates bungeeoxide-minecraft --crate-prelude crate-prelude.rs --crate-dependency bungeeoxide-pds-natives --crate-dependency pds-bytes-runtime --module convert=src/generated/convert.rs"

gen:
	#!/usr/bin/env bash
	set -euo pipefail
	latest=$(grep -oE 'version\(v[0-9a-z_]+' minecraft.pds | tail -n1 | cut -c9-)
	rm -rf {{crates}}/*/src
	{{pds2}} compile minecraft.pds rust --to {{crates}} --view "$latest" {{split}}
	deno run --allow-read=../.. --allow-write=../../Cargo.toml ../../scripts/workspace-crates.ts ../../Cargo.toml {{crates}}
	cargo test -q -p bungeeoxide-converter

update:
	#!/usr/bin/env bash
	set -euo pipefail
	commit=$(< minecraft-data.commit)
	deno run --allow-net=raw.githubusercontent.com --allow-read={{mcdata}},patches,minecraft-data.pins,../../scripts --allow-write={{mcdata}} \
		../../scripts/minecraft-data.ts {{mcdata}} --commit "$commit" --patches patches --pins minecraft-data.pins --releases
	while IFS=$'\t' read -r version protocols served patched snapshots; do
		with=""
		if [[ $patched == patched ]]; then with=" with patches/pc/$version/protocol.json"; fi
		{{pds2}} minecraft-data upgrade {{mcdata}}/patched/pc/$version/protocol.json --to pds/$version.pds \
			--doc "Generated by just update from minecraft-data $commit pc/$version/protocol.json$with, do not edit. Minecraft $served." \
			--protocol "$protocols" ${snapshots:+--snapshot "$snapshots"}
	done < {{mcdata}}/releases.tsv
	deno run --allow-net=raw.githubusercontent.com --allow-read={{mcdata}},patches,minecraft-data.pins,../../scripts --allow-write={{mcdata}},data,src/registry \
		../../scripts/minecraft-registries.ts {{mcdata}} data patches minecraft-data.pins
	just languages
	just pds2={{pds2}} diff

languages:
	#!/usr/bin/env bash
	set -euo pipefail
	commit=$(< minecraft-data.commit)
	mapfile -t versions < <(printf '%s\n' pds/*.pds | sort -V | xargs -n1 basename -s .pds)
	deno run --allow-net=raw.githubusercontent.com --allow-read={{mcdata}},{{languages}},patches,minecraft-data.pins,../../scripts --allow-write={{mcdata}},{{languages}} \
		../../scripts/minecraft-languages.ts {{mcdata}} {{languages}} --commit "$commit" --patches patches --pins minecraft-data.pins "${versions[@]}"

bump:
	deno eval --ext=ts 'import { latestCommit } from "../../scripts/mcdata.ts"; console.log(await latestCommit())' > minecraft-data.commit
	just pds2={{pds2}} update

report *versions:
	cargo run -q --release -p bungeeoxide-converter --example report -- tests/data/1.8-toClient.bin {{versions}}

scaffold:
	#!/usr/bin/env bash
	set -euo pipefail
	mapfile -t versions < <(grep -oE 'version\(v[0-9a-z_]+, name: "[^"]+"' minecraft.pds | cut -d'"' -f2)
	for ((i = 1; i < ${#versions[@]}; i++)); do
		touch "migrations/${versions[i-1]}-${versions[i]}.pds"
	done
	deno run --allow-read=. --allow-write=migrations --allow-run={{pds2}} \
		../../scripts/migration-scaffold.ts migrations -- \
		{{pds2}} compile minecraft.pds rust --check --to {{crates}} {{split}}

diff:
	#!/usr/bin/env bash
	set -euo pipefail
	mapfile -t files < <(printf '%s\n' pds/*.pds | sort -V)
	rm -f migrations/*.diff.txt
	for ((i = 1; i < ${#files[@]}; i++)); do
		old=$(basename "${files[i-1]}" .pds)
		new=$(basename "${files[i]}" .pds)
		{{pds2}} minecraft-data diff "${files[i-1]}" "${files[i]}" > migrations/$old-$new.diff.txt
	done
