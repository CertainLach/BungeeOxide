mcdata := "../../target/minecraft-data"
languages := "../../target/minecraft-languages"
work := "../../target/bungeeoxide-converter"
pds2 := "pds2"
crates := "../../minecraft"

gen:
	#!/usr/bin/env bash
	set -euo pipefail
	mkdir -p {{work}}
	mapfile -t files < <(printf '%s\n' pds/*.pds | sort -V)
	{{pds2}} minecraft-data merge "${files[@]}" --to {{work}}/merged.pds
	rm -rf src/gen {{crates}}
	latest=$(basename "${files[-1]}" .pds)
	{{pds2}} compile {{work}}/merged.pds rust --to {{crates}} --view "v${latest//./_}" \
		--crates bungeeoxide-minecraft --crate-prelude crate-prelude.rs \
		--crate-dependency bungeeoxide-pds-natives --crate-dependency pds-bytes-runtime
	deno run --allow-read=../.. --allow-write=../../Cargo.toml ../../scripts/workspace-crates.ts ../../Cargo.toml {{crates}}
	{{pds2}} minecraft-data converters {{work}}/merged.pds --migrations migrations --gen src/gen --virtual --crates bungeeoxide-minecraft
	cargo test -q -p bungeeoxide-converter

update:
	#!/usr/bin/env bash
	set -euo pipefail
	commit=$(< minecraft-data.commit)
	deno run --allow-net=raw.githubusercontent.com --allow-read={{mcdata}},patches,../../scripts --allow-write={{mcdata}} \
		../../scripts/minecraft-data.ts {{mcdata}} --commit "$commit" --patches patches --releases
	while IFS=$'\t' read -r version protocols served patched; do
		with=""
		if [[ $patched == patched ]]; then with=" with patches/pc/$version/protocol.json"; fi
		{{pds2}} minecraft-data upgrade {{mcdata}}/patched/pc/$version/protocol.json --to pds/$version.pds \
			--doc "Generated by just update from minecraft-data $commit pc/$version/protocol.json$with, do not edit. Minecraft $served." \
			--protocol "$protocols"
	done < {{mcdata}}/releases.tsv
	deno run --allow-net=raw.githubusercontent.com --allow-read={{mcdata}},patches,../../scripts --allow-write={{mcdata}},data,src/registry \
		../../scripts/minecraft-registries.ts {{mcdata}} data patches
	just languages
	just diff

languages:
	#!/usr/bin/env bash
	set -euo pipefail
	commit=$(< minecraft-data.commit)
	mapfile -t versions < <(printf '%s\n' pds/*.pds | sort -V | xargs -n1 basename -s .pds)
	deno run --allow-net=raw.githubusercontent.com --allow-read={{mcdata}},{{languages}},patches,../../scripts --allow-write={{mcdata}},{{languages}} \
		../../scripts/minecraft-languages.ts {{mcdata}} {{languages}} --commit "$commit" --patches patches "${versions[@]}"

bump:
	deno eval --ext=ts 'import { latestCommit } from "../../scripts/mcdata.ts"; console.log(await latestCommit())' > minecraft-data.commit
	just update

converters:
	{{pds2}} minecraft-data converters {{work}}/merged.pds --migrations migrations --gen src/gen --virtual --crates bungeeoxide-minecraft
	cargo test -q -p bungeeoxide-converter

report *versions:
	cargo run -q --release -p bungeeoxide-converter --example report -- tests/data/1.8-toClient.bin {{versions}}

scaffold:
	#!/usr/bin/env bash
	set -euo pipefail
	mkdir -p {{work}}
	mapfile -t files < <(printf '%s\n' pds/*.pds | sort -V)
	{{pds2}} minecraft-data merge "${files[@]}" --to {{work}}/merged.pds
	for ((i = 1; i < ${#files[@]}; i++)); do
		touch "migrations/$(basename "${files[i-1]}" .pds)-$(basename "${files[i]}" .pds).pds"
	done
	deno run --allow-read=. --allow-read={{work}} --allow-write=migrations --allow-run={{pds2}} \
		../../scripts/migration-scaffold.ts migrations -- \
		{{pds2}} minecraft-data converters {{work}}/merged.pds --migrations migrations --gen src/gen --check --crates bungeeoxide-minecraft

diff:
	#!/usr/bin/env bash
	set -euo pipefail
	mapfile -t files < <(printf '%s\n' pds/*.pds | sort -V)
	rm -f migrations/*.diff.txt
	for ((i = 1; i < ${#files[@]}; i++)); do
		old=$(basename "${files[i-1]}" .pds)
		new=$(basename "${files[i]}" .pds)
		{{pds2}} minecraft-data diff "${files[i-1]}" "${files[i]}" > migrations/$old-$new.diff.txt
	done
