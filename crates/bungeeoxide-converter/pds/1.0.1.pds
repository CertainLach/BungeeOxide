@!legacy_protocol [22]

@specializer array
def_native(array) {
	type(Value);

	variant(inline) {
		type(Count);
	};

	variant(sized) {
		argument(count);

		virtual_field(size) => varint;
	};
};

@specializer bitfield
def_native(bitfield) {
	body {
		item(field) {
			argument(size);

			argument(signed) => false;
		};
	};
};

@encoding be @scalar bool def_native(bool);

@specializer buffer
def_native(buffer) {
	variant(inline) {
		type(Count);
	};

	variant(sized) {
		argument(count);

		virtual_field(size) => varint;
	};
};

@specializer container
def_native(container) {
	body {
		item(field) {
			type(Value);
		};

		item(virtual_field) {
			argument(value);

			type(Value);
		};
	};
};

def(entityMetadata) => entityMetadataLoop(end: u8(127)) => container {
	field(ANON) => bitfield {
		field(type, signed: false, size: 3);

		field(key, signed: false, size: 5);
	};

	field(value) => entityMetadataItem(compareTo: ../ANON/type);
};

def(entityMetadataItem) {
	argument(compareTo) => u8;
}
=> union(tag: ./$compareTo) {
	variant(v0, match: 0) => i8;

	variant(v1, match: 1) => i16;

	variant(v2, match: 2) => i32;

	variant(v3, match: 3) => f32;

	variant(v4, match: 4) => string;

	variant(v5, match: 5) => container {
		field(id) => i16;

		field(itemCount) => i8;

		field(itemDamage) => i16;
	};

	variant(v6, match: 6) => container {
		field(x) => i32;

		field(y) => i32;

		field(z) => i32;
	};

	default;
};

@specializer entityMetadataLoop
def_native(entityMetadataLoop) {
	argument(end) => End;

	type(End);

	type(Value);

	body;
};

@encoding be @scalar f32 def_native(f32);

@encoding be @scalar f64 def_native(f64);

@encoding be @scalar i16 def_native(i16);

@encoding be @scalar i32 def_native(i32);

@encoding be @scalar i64 def_native(i64);

@encoding be @scalar i8 def_native(i8);

def_native(legacySlot);

def(position_ibi) => container {
	field(x) => i32;

	field(y) => u8;

	field(z) => i32;
};

def(position_iii) => container {
	field(x) => i32;

	field(y) => i32;

	field(z) => i32;
};

def(position_isi) => container {
	field(x) => i32;

	field(y) => i16;

	field(z) => i32;
};

def(slot) => legacySlot;

def(string) => string16;

@scalar string def_native(string16);

@specializer union
def_native(union) {
	body {
		item(variant) {
			argument(match);

			type(Value) => void;
		};

		item(default) {
			anonymous;

			type(Value) => void;
		};
	};

	variant(external) {
		argument(tag);
	};

	variant(inline) {
		type(Tag);
	};
};

@encoding be @scalar u16 def_native(u16);

@encoding be @scalar u8 def_native(u8);

@encoding varint @scalar i32 def_native(varint);

def(vec3i16) => container {
	field(x) => i16;

	field(y) => i16;

	field(z) => i16;
};

def_native(void) {
	is_void;
};

namespace(play) {
	namespace(toClient) {
		def(packet) => union(Tag: u8) {
			variant(keep_alive, match: 0) => packet_keep_alive;

			variant(login, match: 1) => packet_login;

			variant(handshake, match: 2) => packet_handshake;

			variant(chat, match: 3) => packet_chat;

			variant(update_time, match: 4) => packet_update_time;

			variant(entity_equipment, match: 5) => packet_entity_equipment;

			variant(spawn_position, match: 6) => packet_spawn_position;

			variant(update_health, match: 8) => packet_update_health;

			variant(respawn, match: 9) => packet_respawn;

			variant(flying, match: 10) => packet_flying;

			variant(position_only, match: 11) => packet_position_only;

			variant(look, match: 12) => packet_look;

			variant(position, match: 13) => packet_position;

			variant(bed, match: 17) => packet_bed;

			variant(animation, match: 18) => packet_animation;

			variant(named_entity_spawn, match: 20) => packet_named_entity_spawn;

			variant(spawn_entity_item, match: 21) => packet_spawn_entity_item;

			variant(collect, match: 22) => packet_collect;

			variant(spawn_entity, match: 23) => packet_spawn_entity;

			variant(spawn_entity_living, match: 24) => packet_spawn_entity_living;

			variant(spawn_entity_painting, match: 25) => packet_spawn_entity_painting;

			variant(spawn_entity_experience_orb, match: 26) => packet_spawn_entity_experience_orb;

			variant(entity_velocity, match: 28) => packet_entity_velocity;

			variant(entity_destroy, match: 29) => packet_entity_destroy;

			variant(entity, match: 30) => packet_entity;

			variant(rel_entity_move, match: 31) => packet_rel_entity_move;

			variant(entity_look, match: 32) => packet_entity_look;

			variant(entity_move_look, match: 33) => packet_entity_move_look;

			variant(entity_teleport, match: 34) => packet_entity_teleport;

			variant(entity_status, match: 38) => packet_entity_status;

			variant(attach_entity, match: 39) => packet_attach_entity;

			variant(entity_metadata, match: 40) => packet_entity_metadata;

			variant(entity_effect, match: 41) => packet_entity_effect;

			variant(remove_entity_effect, match: 42) => packet_remove_entity_effect;

			variant(experience, match: 43) => packet_experience;

			variant(pre_chunk, match: 50) => packet_pre_chunk;

			variant(map_chunk, match: 51) => packet_map_chunk;

			variant(multi_block_change, match: 52) => packet_multi_block_change;

			variant(block_change, match: 53) => packet_block_change;

			variant(block_action, match: 54) => packet_block_action;

			variant(explosion, match: 60) => packet_explosion;

			variant(world_event, match: 61) => packet_world_event;

			variant(game_state_change, match: 70) => packet_game_state_change;

			variant(spawn_entity_weather, match: 71) => packet_spawn_entity_weather;

			variant(open_window, match: 100) => packet_open_window;

			variant(close_window, match: 101) => packet_close_window;

			variant(set_slot, match: 103) => packet_set_slot;

			variant(window_items, match: 104) => packet_window_items;

			variant(craft_progress_bar, match: 105) => packet_craft_progress_bar;

			variant(transaction, match: 106) => packet_transaction;

			variant(set_creative_slot, match: 107) => packet_set_creative_slot;

			variant(update_sign, match: 130) => packet_update_sign;

			variant(map, match: 131) => packet_map;

			variant(statistics, match: 200) => packet_statistics;

			variant(player_info, match: 201) => packet_player_info;

			variant(kick_disconnect, match: 255) => packet_kick_disconnect;

			default;
		};

		def(packet_animation) => container {
			field(entityId) => i32;

			field(animation) => u8;
		};

		def(packet_attach_entity) => container {
			field(entityId) => i32;

			field(vehicleId) => i32;
		};

		def(packet_bed) => container {
			field(entityId) => i32;

			field(action) => i8;

			field(location) => position_ibi;
		};

		def(packet_block_action) => container {
			field(location) => position_isi;

			field(byte1) => u8;

			field(byte2) => u8;
		};

		def(packet_block_change) => container {
			field(location) => position_ibi;

			field(type) => u8;

			field(metadata) => u8;
		};

		def(packet_chat) => string;

		def(packet_close_window) => u8;

		def(packet_collect) => container {
			field(collectedEntityId) => i32;

			field(collectorEntityId) => i32;
		};

		def(packet_craft_progress_bar) => container {
			field(windowId) => u8;

			field(property) => i16;

			field(value) => i16;
		};

		def(packet_entity) => i32;

		def(packet_entity_destroy) => i32;

		def(packet_entity_effect) => container {
			field(entityId) => i32;

			field(effectId) => i8;

			field(amplifier) => i8;

			field(duration) => i16;
		};

		def(packet_entity_equipment) => container {
			field(entityId) => i32;

			field(slot) => i16;

			field(itemId) => i16;

			field(itemDamage) => i16;
		};

		def(packet_entity_look) => container {
			field(entityId) => i32;

			field(yaw) => i8;

			field(pitch) => i8;
		};

		def(packet_entity_metadata) => container {
			field(entityId) => i32;

			field(metadata) => entityMetadata;
		};

		def(packet_entity_move_look) => container {
			field(entityId) => i32;

			field(dX) => i8;

			field(dY) => i8;

			field(dZ) => i8;

			field(yaw) => i8;

			field(pitch) => i8;
		};

		def(packet_entity_status) => container {
			field(entityId) => i32;

			field(entityStatus) => i8;
		};

		def(packet_entity_teleport) => container {
			field(entityId) => i32;

			field(x) => i32;

			field(y) => i32;

			field(z) => i32;

			field(yaw) => i8;

			field(pitch) => i8;
		};

		def(packet_entity_velocity) => container {
			field(entityId) => i32;

			field(velocity) => vec3i16;
		};

		def(packet_experience) => container {
			field(experienceBar) => f32;

			field(level) => i16;

			field(totalExperience) => i16;
		};

		def(packet_explosion) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(radius) => f32;

			field(affectedBlockOffsets) => array(Count: i32) => container {
				field(x) => i8;

				field(y) => i8;

				field(z) => i8;
			};
		};

		def(packet_flying) => bool;

		def(packet_game_state_change) => container {
			field(reason) => union(Tag: u8) {
				variant(no_respawn_block_available, match: 0);

				variant(start_raining, match: 1);

				variant(stop_raining, match: 2);

				variant(change_game_mode, match: 3);

				variant(win_game, match: 4);

				variant(demo_event, match: 5);

				variant(play_arrow_hit_sound, match: 6);

				default;
			};

			field(gameMode) => i8;
		};

		def(packet_handshake) => container {
			field(connectionHash) => string;
		};

		def(packet_keep_alive) => i32;

		def(packet_kick_disconnect) => string;

		def(packet_login) => container {
			field(entityId) => i32;

			field(username) => string;

			field(seed) => i64;

			field(gameMode) => i32;

			field(dimension) => i8;

			field(difficulty) => u8;

			field(worldHeight) => u8;

			field(maxPlayers) => u8;
		};

		def(packet_look) => container {
			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_map) => container {
			field(itemType) => i16;

			field(itemDamage) => i16;

			field(data) => buffer(Count: u8);
		};

		def(packet_map_chunk) => container {
			field(x) => i32;

			field(y) => i16;

			field(z) => i32;

			field(sizeX) => u8;

			field(sizeY) => u8;

			field(sizeZ) => u8;

			field(compressedChunkData) => buffer(Count: i32);
		};

		def(packet_multi_block_change) => container {
			field(chunkX) => i32;

			field(chunkZ) => i32;

			virtual_field(recordCount, value: i16(./coordinates/@size)) => i16;

			field(coordinates) => array(count: ../recordCount) => bitfield {
				field(x, signed: false, size: 4);

				field(z, signed: false, size: 4);

				field(y, signed: false, size: 8);
			};

			field(blockIds) => array(count: ../recordCount) => u8;

			field(metadata) => array(count: ../recordCount) => u8;
		};

		def(packet_named_entity_spawn) => container {
			field(entityId) => i32;

			field(playerName) => string;

			field(x) => i32;

			field(y) => i32;

			field(z) => i32;

			field(yaw) => i8;

			field(pitch) => i8;

			field(currentItem) => i16;
		};

		def(packet_open_window) => container {
			field(windowId) => u8;

			field(inventoryType) => u8;

			field(windowTitle) => string;

			field(slotCount) => u8;
		};

		def(packet_player_info) => container {
			field(playerName) => string;

			field(online) => bool;

			field(ping) => i16;
		};

		def(packet_position) => container {
			field(x) => f64;

			field(y) => f64;

			field(stance) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_position_only) => container {
			field(x) => f64;

			field(y) => f64;

			field(stance) => f64;

			field(z) => f64;

			field(onGround) => bool;
		};

		def(packet_pre_chunk) => container {
			field(x) => i32;

			field(z) => i32;

			field(mode) => bool;
		};

		def(packet_rel_entity_move) => container {
			field(entityId) => i32;

			field(dX) => i8;

			field(dY) => i8;

			field(dZ) => i8;
		};

		def(packet_remove_entity_effect) => container {
			field(entityId) => i32;

			field(effectId) => i8;
		};

		def(packet_respawn) => container {
			field(dimension) => i8;

			field(difficulty) => u8;

			field(gamemode) => u8;

			field(worldHeight) => i16;

			field(seed) => i64;
		};

		def(packet_set_creative_slot) => container {
			field(slot) => i16;

			field(item) => slot;
		};

		def(packet_set_slot) => container {
			field(windowId) => i8;

			field(slot) => i16;

			field(item) => slot;
		};

		def(packet_spawn_entity) => container {
			field(entityId) => i32;

			field(type) => i8;

			field(x) => i32;

			field(y) => i32;

			field(z) => i32;

			field(objectData) => union(Tag: i32) {
				variant(v0, match: 0) => void;

				default => container {
					field(velocityX) => i16;

					field(velocityY) => i16;

					field(velocityZ) => i16;
				};
			};
		};

		def(packet_spawn_entity_experience_orb) => container {
			field(entityId) => i32;

			field(x) => i32;

			field(y) => i32;

			field(z) => i32;

			field(count) => i16;
		};

		def(packet_spawn_entity_item) => container {
			field(entityId) => i32;

			field(item) => container {
				field(id) => i16;

				field(itemCount) => i8;

				field(itemDamage) => i16;
			};

			field(x) => i32;

			field(y) => i32;

			field(z) => i32;

			field(velocityX) => i8;

			field(velocityY) => i8;

			field(velocityZ) => i8;
		};

		def(packet_spawn_entity_living) => container {
			field(entityId) => i32;

			field(type) => u8;

			field(x) => i32;

			field(y) => i32;

			field(z) => i32;

			field(yaw) => i8;

			field(pitch) => i8;

			field(metadata) => entityMetadata;
		};

		def(packet_spawn_entity_painting) => container {
			field(entityId) => i32;

			field(title) => string;

			field(location) => position_iii;

			field(direction) => i32;
		};

		def(packet_spawn_entity_weather) => container {
			field(entityId) => i32;

			field(type) => i8;

			field(x) => i32;

			field(y) => i32;

			field(z) => i32;
		};

		def(packet_spawn_position) => position_iii;

		def(packet_statistics) => container {
			field(statisticId) => i32;

			field(amount) => i8;
		};

		def(packet_transaction) => container {
			field(windowId) => u8;

			field(action) => i16;

			field(accepted) => bool;
		};

		def(packet_update_health) => container {
			field(health) => i16;

			field(food) => i16;

			field(foodSaturation) => f32;
		};

		def(packet_update_sign) => container {
			field(location) => position_isi;

			field(text1) => string;

			field(text2) => string;

			field(text3) => string;

			field(text4) => string;
		};

		def(packet_update_time) => container {
			field(time) => i64;
		};

		def(packet_window_items) => container {
			field(windowId) => u8;

			field(items) => array(Count: i16) => slot;
		};

		def(packet_world_event) => container {
			field(effectId) => i32;

			field(location) => position_ibi;

			field(data) => i32;
		};
	};

	namespace(toServer) {
		def(packet) => union(Tag: u8) {
			variant(keep_alive, match: 0) => packet_keep_alive;

			variant(login, match: 1) => packet_login;

			variant(set_protocol, match: 2) => packet_set_protocol;

			variant(chat, match: 3) => packet_chat;

			variant(use_entity, match: 7) => packet_use_entity;

			variant(respawn, match: 9) => packet_respawn;

			variant(flying, match: 10) => packet_flying;

			variant(position, match: 11) => packet_position;

			variant(look, match: 12) => packet_look;

			variant(position_look, match: 13) => packet_position_look;

			variant(block_dig, match: 14) => packet_block_dig;

			variant(block_place, match: 15) => packet_block_place;

			variant(held_item_slot, match: 16) => packet_held_item_slot;

			variant(arm_animation, match: 18) => packet_arm_animation;

			variant(entity_action, match: 19) => packet_entity_action;

			variant(stance_update, match: 27) => packet_stance_update;

			variant(close_window, match: 101) => packet_close_window;

			variant(window_click, match: 102) => packet_window_click;

			variant(transaction, match: 106) => packet_transaction;

			variant(set_creative_slot, match: 107) => packet_set_creative_slot;

			variant(enchant_item, match: 108) => packet_enchant_item;

			variant(update_sign, match: 130) => packet_update_sign;

			variant(legacy_server_list_ping, match: 254) => packet_legacy_server_list_ping;

			variant(kick_disconnect, match: 255) => packet_kick_disconnect;

			default;
		};

		def(packet_arm_animation) => container {
			field(entityId) => i32;

			field(animation) => i8;
		};

		def(packet_block_dig) => container {
			field(status) => i8;

			field(location) => position_ibi;

			field(face) => i8;
		};

		def(packet_block_place) => container {
			field(location) => position_ibi;

			field(direction) => i8;

			field(heldItem) => slot;
		};

		def(packet_chat) => string;

		def(packet_close_window) => u8;

		def(packet_enchant_item) => container {
			field(windowId) => i8;

			field(enchantment) => i8;
		};

		def(packet_entity_action) => container {
			field(entityId) => i32;

			field(actionId) => i8;
		};

		def(packet_flying) => bool;

		def(packet_held_item_slot) => i16;

		def(packet_keep_alive) => i32;

		def(packet_kick_disconnect) => string;

		def(packet_legacy_server_list_ping) => container;

		def(packet_login) => container {
			field(protocolVersion) => i32;

			field(username) => string;

			field(seed) => i64;

			field(gameMode) => i32;

			field(dimension) => i8;

			field(difficulty) => u8;

			field(worldHeight) => u8;

			field(maxPlayers) => u8;
		};

		def(packet_look) => container {
			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_position) => container {
			field(x) => f64;

			field(y) => f64;

			field(stance) => f64;

			field(z) => f64;

			field(onGround) => bool;
		};

		def(packet_position_look) => container {
			field(x) => f64;

			field(y) => f64;

			field(stance) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_respawn) => container {
			field(dimension) => i8;

			field(difficulty) => u8;

			field(gamemode) => u8;

			field(worldHeight) => i16;

			field(seed) => i64;
		};

		def(packet_set_creative_slot) => container {
			field(slot) => i16;

			field(item) => slot;
		};

		def(packet_set_protocol) => container {
			field(username) => string;
		};

		def(packet_stance_update) => container {
			field(sideways) => f32;

			field(forward) => f32;

			field(pitch) => f32;

			field(yaw) => f32;

			field(jump) => bool;

			field(unmount) => bool;
		};

		def(packet_transaction) => container {
			field(windowId) => i8;

			field(action) => i16;

			field(accepted) => bool;
		};

		def(packet_update_sign) => container {
			field(location) => position_isi;

			field(text1) => string;

			field(text2) => string;

			field(text3) => string;

			field(text4) => string;
		};

		def(packet_use_entity) => container {
			field(user) => i32;

			field(target) => i32;

			field(mouse) => i8;
		};

		def(packet_window_click) => container {
			field(windowId) => i8;

			field(slot) => i16;

			field(mouseButton) => i8;

			field(action) => i16;

			field(mode) => i8;

			field(item) => slot;
		};
	};
};
