def_native(UUID);

@view take def_native(anonOptionalNbt);

@view take def_native(anonymousNbt);

@specializer array
def_native(array) {
	type(Value);

	variant(inline) {
		type(Count);
	};

	variant(sized) {
		argument(count);

		virtual_field(size) => varint;
	};
};

@specializer bitfield
def_native(bitfield) {
	body {
		item(field) {
			argument(size);

			argument(signed) => false;
		};
	};
};

@specializer bitflags
def_native(bitflags) {
	type(Value);

	body {
		item(flag);
	};
};

@encoding be @scalar bool def_native(bool);

@specializer buffer
def_native(buffer) {
	variant(inline) {
		type(Count);
	};

	variant(sized) {
		argument(count);

		virtual_field(size) => varint;
	};
};

def(chat_session) => option => container {
	field(uuid) => UUID;

	field(publicKey) => container {
		field(expireTime) => i64;

		field(keyBytes) => buffer(Count: varint);

		field(keySignature) => buffer(Count: varint);
	};
};

def(chunkBlockEntity) => container {
	field(ANON) => bitfield {
		field(x, signed: false, size: 4);

		field(z, signed: false, size: 4);
	};

	field(y) => i16;

	field(type) => varint;

	field(nbtData) => anonOptionalNbt;
};

def(command_node) => container {
	field(flags) => bitfield {
		field(unused, signed: false, size: 3);

		field(has_custom_suggestions, signed: false, size: 1);

		field(has_redirect_node, signed: false, size: 1);

		field(has_command, signed: false, size: 1);

		field(command_node_type, signed: false, size: 2);
	};

	field(children) => array(Count: varint) => varint;

	field(redirectNode) => union(tag: ../flags/has_redirect_node) {
		variant(v1, match: 1) => varint;

		default => void;
	};

	field(extraNodeData) => union(tag: ../flags/command_node_type) {
		variant(v0, match: 0) => void;

		variant(v1, match: 1) => string;

		variant(v2, match: 2) => container {
			field(name) => string;

			field(properties) => union(Tag: varint) {
				variant(brigadier_bool, match: 0) => void;

				variant(brigadier_float, match: 1) => container {
					field(flags) => bitfield {
						field(unused, signed: false, size: 6);

						field(max_present, signed: false, size: 1);

						field(min_present, signed: false, size: 1);
					};

					field(min) => union(tag: ../flags/min_present) {
						variant(v1, match: 1) => f32;

						default => void;
					};

					field(max) => union(tag: ../flags/max_present) {
						variant(v1, match: 1) => f32;

						default => void;
					};
				};

				variant(minecraft_vec3, match: 10) => void;

				variant(minecraft_vec2, match: 11) => void;

				variant(minecraft_block_state, match: 12) => void;

				variant(minecraft_block_predicate, match: 13) => void;

				variant(minecraft_item_stack, match: 14) => void;

				variant(minecraft_item_predicate, match: 15) => void;

				variant(minecraft_color, match: 16) => void;

				variant(minecraft_component, match: 17) => void;

				variant(minecraft_style, match: 18);

				variant(minecraft_message, match: 19) => void;

				variant(brigadier_double, match: 2) => container {
					field(flags) => bitfield {
						field(unused, signed: false, size: 6);

						field(max_present, signed: false, size: 1);

						field(min_present, signed: false, size: 1);
					};

					field(min) => union(tag: ../flags/min_present) {
						variant(v1, match: 1) => f64;

