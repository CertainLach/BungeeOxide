			field(emptyBlockLightMask) => varint;

			field(data) => restBuffer;
		};

		def(packet_update_time) => container {
			field(age) => i64;

			field(time) => i64;
		};

		def(packet_update_view_distance) => varint;

		def(packet_update_view_position) => container {
			field(chunkX) => varint;

			field(chunkZ) => varint;
		};

		def(packet_vehicle_move) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;
		};

		def(packet_window_items) => container {
			field(windowId) => u8;

			field(items) => array(Count: i16) => slot;
		};

		def(packet_world_border) => union(Tag: varint) {
			variant(v0, match: 0) => f64;

			variant(v1, match: 1) => container {
				field(old_radius) => f64;

				field(new_radius) => f64;

				field(speed) => varlong;
			};

			variant(v2, match: 2) => container {
				field(x) => f64;

				field(z) => f64;
			};

			variant(v3, match: 3) => container {
				field(x) => f64;

				field(z) => f64;

				field(old_radius) => f64;

				field(new_radius) => f64;

				field(speed) => varlong;

				field(portalBoundary) => varint;

				field(warning_time) => varint;

				field(warning_blocks) => varint;
			};

			variant(v4, match: 4) => varint;

			variant(v5, match: 5) => varint;

			default;
		};

		def(packet_world_event) => container {
			field(effectId) => i32;

			field(location) => position;

			field(data) => i32;

			field(global) => bool;
		};

		def(packet_world_particles) => container {
			field(particleId) => i32;

			field(longDistance) => bool;

			field(x) => f32;

			field(y) => f32;

			field(z) => f32;

			field(offsetX) => f32;

			field(offsetY) => f32;

			field(offsetZ) => f32;

			field(particleData) => f32;

			field(particles) => i32;

			field(data) => particleData(compareTo: ../particleId);
		};
	};

	namespace(toServer) {
		def(packet) => union(Tag: varint) {
			variant(teleport_confirm, match: 0) => packet_teleport_confirm;

			variant(query_block_nbt, match: 1) => packet_query_block_nbt;

			variant(set_difficulty, match: 2) => packet_set_difficulty;

			variant(chat, match: 3) => packet_chat;

			variant(client_command, match: 4) => packet_client_command;

			variant(settings, match: 5) => packet_settings;

			variant(tab_complete, match: 6) => packet_tab_complete;

			variant(transaction, match: 7) => packet_transaction;

			variant(enchant_item, match: 8) => packet_enchant_item;

			variant(window_click, match: 9) => packet_window_click;

			variant(close_window, match: 10) => packet_close_window;

			variant(custom_payload, match: 11) => packet_custom_payload;

			variant(edit_book, match: 12) => packet_edit_book;

			variant(query_entity_nbt, match: 13) => packet_query_entity_nbt;

			variant(use_entity, match: 14) => packet_use_entity;

			variant(keep_alive, match: 15) => packet_keep_alive;

			variant(lock_difficulty, match: 16) => packet_lock_difficulty;

			variant(position, match: 17) => packet_position;

			variant(position_look, match: 18) => packet_position_look;

			variant(look, match: 19) => packet_look;

			variant(flying, match: 20) => packet_flying;

			variant(vehicle_move, match: 21) => packet_vehicle_move;

			variant(steer_boat, match: 22) => packet_steer_boat;

			variant(pick_item, match: 23) => packet_pick_item;

			variant(craft_recipe_request, match: 24) => packet_craft_recipe_request;

			variant(abilities, match: 25) => packet_abilities;

			variant(block_dig, match: 26) => packet_block_dig;

			variant(entity_action, match: 27) => packet_entity_action;

			variant(steer_vehicle, match: 28) => packet_steer_vehicle;

			variant(crafting_book_data, match: 29) => packet_crafting_book_data;

			variant(name_item, match: 30) => packet_name_item;

			variant(resource_pack_receive, match: 31) => packet_resource_pack_receive;

			variant(advancement_tab, match: 32) => packet_advancement_tab;

			variant(select_trade, match: 33) => packet_select_trade;

			variant(set_beacon_effect, match: 34) => packet_set_beacon_effect;

			variant(held_item_slot, match: 35) => packet_held_item_slot;

			variant(update_command_block, match: 36) => packet_update_command_block;

			variant(update_command_block_minecart, match: 37) => packet_update_command_block_minecart;

			variant(set_creative_slot, match: 38) => packet_set_creative_slot;

			variant(update_jigsaw_block, match: 39) => packet_update_jigsaw_block;

			variant(update_structure_block, match: 40) => packet_update_structure_block;

			variant(update_sign, match: 41) => packet_update_sign;

			variant(arm_animation, match: 42) => packet_arm_animation;

			variant(spectate, match: 43) => packet_spectate;

			variant(block_place, match: 44) => packet_block_place;

			variant(use_item, match: 45) => packet_use_item;

			default;
		};

		def(packet_abilities) => container {
			field(flags) => i8;

			field(flyingSpeed) => f32;

			field(walkingSpeed) => f32;
		};

		def(packet_advancement_tab) => union(Tag: varint) {
			variant(v0, match: 0) => string;

			variant(v1, match: 1) => void;

			default;
		};

		def(packet_arm_animation) => varint;

		def(packet_block_dig) => container {
			field(status) => varint;

			field(location) => position;

			field(face) => i8;
		};

		def(packet_block_place) => container {
			field(hand) => varint;

			field(location) => position;

			field(direction) => varint;

			field(cursorX) => f32;

			field(cursorY) => f32;

			field(cursorZ) => f32;

			field(insideBlock) => bool;
		};

		def(packet_chat) => string;

		def(packet_client_command) => union(Tag: varint) {
			variant(perform_respawn, match: 0);

			variant(request_stats, match: 1);

			default;
		};

		def(packet_close_window) => u8;

		def(packet_craft_recipe_request) => container {
			field(windowId) => i8;

			field(recipe) => string;

			field(makeAll) => bool;
		};

		def(packet_crafting_book_data) => union(Tag: varint) {
			variant(v0, match: 0) => string;

			variant(v1, match: 1) => container {
				field(craftingBookOpen) => bool;

				field(craftingFilter) => bool;

				field(smeltingBookOpen) => bool;

				field(smeltingFilter) => bool;

				field(blastingBookOpen) => bool;

				field(blastingFilter) => bool;

				field(smokingBookOpen) => bool;

				field(smokingFilter) => bool;
			};

			default;
		};

		def(packet_custom_payload) => container {
			field(channel) => string;

			field(data) => restBuffer;
		};

		def(packet_edit_book) => container {
			field(new_book) => slot;

			field(signing) => bool;

			field(hand) => varint;
		};

		def(packet_enchant_item) => container {
			field(windowId) => i8;

			field(enchantment) => i8;
		};

		def(packet_entity_action) => container {
			field(entityId) => varint;

			field(actionId) => union(Tag: varint) {
				variant(start_sneaking, match: 0);

				variant(stop_sneaking, match: 1);

				variant(stop_sleeping, match: 2);

				variant(start_sprinting, match: 3);

				variant(stop_sprinting, match: 4);

				variant(start_riding_jump, match: 5);

				variant(stop_riding_jump, match: 6);

				variant(open_inventory, match: 7);

				variant(start_fall_flying, match: 8);

				default;
			};

			field(jumpBoost) => varint;
		};

		def(packet_flying) => bool;

		def(packet_held_item_slot) => i16;

		def(packet_keep_alive) => i64;

		def(packet_lock_difficulty) => bool;

		def(packet_look) => container {
			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_name_item) => string;

		def(packet_pick_item) => varint;

		def(packet_position) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(onGround) => bool;
		};

		def(packet_position_look) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_query_block_nbt) => container {
			field(transactionId) => varint;

			field(location) => position;
		};

		def(packet_query_entity_nbt) => container {
			field(transactionId) => varint;

			field(entityId) => varint;
		};

		def(packet_resource_pack_receive) => varint;

		def(packet_select_trade) => varint;

		def(packet_set_beacon_effect) => container {
			field(primary_effect) => varint;

			field(secondary_effect) => varint;
		};

		def(packet_set_creative_slot) => container {
			field(slot) => i16;

			field(item) => slot;
		};

		def(packet_set_difficulty) => union(Tag: u8) {
			variant(peaceful, match: 0);

			variant(easy, match: 1);

			variant(normal, match: 2);

			variant(hard, match: 3);

			default;
		};

		def(packet_settings) => container {
			field(locale) => string;

			field(viewDistance) => i8;

			field(chatFlags) => varint;

			field(chatColors) => bool;

			field(skinParts) => u8;

			field(mainHand) => varint;
		};

		def(packet_spectate) => UUID;

		def(packet_steer_boat) => container {
			field(leftPaddle) => bool;

			field(rightPaddle) => bool;
		};

		def(packet_steer_vehicle) => container {
			field(sideways) => f32;

			field(forward) => f32;

			field(jump) => u8;
		};

		def(packet_tab_complete) => container {
			field(transactionId) => varint;

			field(text) => string;
		};

		def(packet_teleport_confirm) => varint;

		def(packet_transaction) => container {
			field(windowId) => i8;

			field(action) => i16;

			field(accepted) => bool;
		};

		def(packet_update_command_block) => container {
			field(location) => position;

			field(command) => string;

			field(mode) => varint;

			field(flags) => u8;
		};

		def(packet_update_command_block_minecart) => container {
			field(entityId) => varint;

			field(command) => string;

			field(track_output) => bool;
		};

		def(packet_update_jigsaw_block) => container {
			field(location) => position;

			field(attachmentType) => string;

			field(targetPool) => string;

			field(finalState) => string;
		};

		def(packet_update_sign) => container {
			field(location) => position;

			field(text1) => string;

			field(text2) => string;

			field(text3) => string;

			field(text4) => string;
		};

		def(packet_update_structure_block) => container {
			field(location) => position;

			field(action) => varint;

			field(mode) => varint;

			field(name) => string;

			field(offset_x) => i8;

			field(offset_y) => i8;

			field(offset_z) => i8;

			field(size_x) => i8;

			field(size_y) => i8;

			field(size_z) => i8;

			field(mirror) => varint;

			field(rotation) => varint;

			field(metadata) => string;

			field(integrity) => f32;

			field(seed) => varlong;

			field(flags) => u8;
		};

		def(packet_use_entity) => container {
			field(target) => varint;

			field(mouse) => union(Tag: varint) {
				variant(v0, match: 0) => varint;

				variant(v2, match: 2) => container {
					field(x) => f32;

					field(y) => f32;

					field(z) => f32;

					field(hand) => varint;
				};

				default;
			};
		};

		def(packet_use_item) => varint;

		def(packet_vehicle_move) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;
		};

		def(packet_window_click) => container {
			field(windowId) => u8;

			field(slot) => i16;

			field(mouseButton) => i8;

			field(action) => i16;

			field(mode) => i8;

			field(item) => slot;
		};
	};
};

namespace(status) {
	namespace(toClient) {
		def(packet) => union(Tag: varint) {
			variant(server_info, match: 0) => packet_server_info;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_server_info) => string;
	};

	namespace(toServer) {
		def(packet) => union(Tag: varint) {
			variant(ping_start, match: 0) => packet_ping_start;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_ping_start) => container;
	};
};
