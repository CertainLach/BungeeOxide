			field(scoreName) => string;

			field(value) => union(tag: ../action) {
				variant(v1, match: 1) => void;

				default => varint;
			};
		};

		def(packet_set_cooldown) => container {
			field(itemID) => varint;

			field(cooldownTicks) => varint;
		};

		def(packet_set_passengers) => container {
			field(entityId) => varint;

			field(passengers) => array(Count: varint) => varint;
		};

		def(packet_set_slot) => container {
			field(windowId) => i8;

			field(slot) => i16;

			field(item) => slot;
		};

		def(packet_sound_effect) => container {
			field(soundId) => varint;

			field(soundCategory) => varint;

			field(x) => i32;

			field(y) => i32;

			field(z) => i32;

			field(volume) => f32;

			field(pitch) => u8;
		};

		def(packet_spawn_entity) => container {
			field(entityId) => varint;

			field(objectUUID) => UUID;

			field(type) => i8;

			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(pitch) => i8;

			field(yaw) => i8;

			field(objectData) => i32;

			field(velocity) => vec3i16;
		};

		def(packet_spawn_entity_experience_orb) => container {
			field(entityId) => varint;

			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(count) => i16;
		};

		def(packet_spawn_entity_living) => container {
			field(entityId) => varint;

			field(entityUUID) => UUID;

			field(type) => u8;

			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(yaw) => i8;

			field(pitch) => i8;

			field(headPitch) => i8;

			field(velocity) => vec3i16;

			field(metadata) => entityMetadata;
		};

		def(packet_spawn_entity_painting) => container {
			field(entityId) => varint;

			field(entityUUID) => UUID;

			field(title) => string;

			field(location) => position;

			field(direction) => u8;
		};

		def(packet_spawn_entity_weather) => container {
			field(entityId) => varint;

			field(type) => i8;

			field(x) => f64;

			field(y) => f64;

			field(z) => f64;
		};

		def(packet_spawn_position) => position;

		def(packet_statistics) => array(Count: varint) => container {
			field(name) => string;

			field(value) => varint;
		};

		def(packet_tab_complete) => array(Count: varint) => string;

		def(packet_teams) => container {
			field(team) => string;

			field(mode) => union(Tag: i8) {
				variant(v0, match: 0) => container {
					field(name) => string;

					field(prefix) => string;

					field(suffix) => string;

					field(friendlyFire) => i8;

					field(nameTagVisibility) => string;

					field(collisionRule) => string;

					field(color) => i8;

					field(players) => array(Count: varint) => string;
				};

				variant(v2, match: 2) => container {
					field(name) => string;

					field(prefix) => string;

					field(suffix) => string;

					field(friendlyFire) => i8;

					field(nameTagVisibility) => string;

					field(collisionRule) => string;

					field(color) => i8;
				};

				variant(v3, match: 3) => array(Count: varint) => string;

				variant(v4, match: 4) => array(Count: varint) => string;

				default;
			};
		};

		def(packet_tile_entity_data) => container {
			field(location) => position;

			field(action) => u8;

			field(nbtData) => optionalNbt;
		};

		def(packet_title) => union(Tag: varint) {
			variant(v0, match: 0) => string;

			variant(v1, match: 1) => string;

			variant(v2, match: 2) => container {
				field(fadeIn) => i32;

				field(stay) => i32;

				field(fadeOut) => i32;
			};

			default;
		};

		def(packet_transaction) => container {
			field(windowId) => i8;

			field(action) => i16;

			field(accepted) => bool;
		};

		def(packet_unload_chunk) => container {
			field(chunkX) => i32;

			field(chunkZ) => i32;
		};

		def(packet_update_health) => container {
			field(health) => f32;

			field(food) => varint;

			field(foodSaturation) => f32;
		};

		def(packet_update_sign) => container {
			field(location) => position;

			field(text1) => string;

			field(text2) => string;

			field(text3) => string;

			field(text4) => string;
		};

		def(packet_update_time) => container {
			field(age) => i64;

			field(time) => i64;
		};

		def(packet_vehicle_move) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;
		};

		def(packet_window_items) => container {
			field(windowId) => u8;

			field(items) => array(Count: i16) => slot;
		};

		def(packet_world_border) => union(Tag: varint) {
			variant(v0, match: 0) => f64;

			variant(v1, match: 1) => container {
				field(old_radius) => f64;

				field(new_radius) => f64;

				field(speed) => varlong;
			};

			variant(v2, match: 2) => container {
				field(x) => f64;

				field(z) => f64;
			};

			variant(v3, match: 3) => container {
				field(x) => f64;

				field(z) => f64;

				field(old_radius) => f64;

				field(new_radius) => f64;

				field(speed) => varlong;

				field(portalBoundary) => varint;

				field(warning_time) => varint;

				field(warning_blocks) => varint;
			};

			variant(v4, match: 4) => varint;

			variant(v5, match: 5) => varint;

			default;
		};

		def(packet_world_event) => container {
			field(effectId) => i32;

			field(location) => position;

			field(data) => i32;

			field(global) => bool;
		};

		def(packet_world_particles) => container {
			virtual_field(particleId, value: ./data/@tag) => i32;

			field(longDistance) => bool;

			field(x) => f32;

			field(y) => f32;

			field(z) => f32;

			field(offsetX) => f32;

			field(offsetY) => f32;

			field(offsetZ) => f32;

			field(particleData) => f32;

			field(particles) => i32;

			field(data) => union(tag: ../particleId) {
				variant(v36, match: 36) => array(count: 2) => varint;

				variant(v37, match: 37) => array(count: 1) => varint;

				variant(v38, match: 38) => array(count: 1) => varint;

				default => void;
			};
		};
	};

	namespace(toServer) {
		def(packet) => union(Tag: varint) {
			variant(teleport_confirm, match: 0) => packet_teleport_confirm;

			variant(tab_complete, match: 1) => packet_tab_complete;

			variant(chat, match: 2) => packet_chat;

			variant(client_command, match: 3) => packet_client_command;

			variant(settings, match: 4) => packet_settings;

			variant(transaction, match: 5) => packet_transaction;

			variant(enchant_item, match: 6) => packet_enchant_item;

			variant(window_click, match: 7) => packet_window_click;

			variant(close_window, match: 8) => packet_close_window;

			variant(custom_payload, match: 9) => packet_custom_payload;

			variant(use_entity, match: 10) => packet_use_entity;

			variant(keep_alive, match: 11) => packet_keep_alive;

			variant(position, match: 12) => packet_position;

			variant(position_look, match: 13) => packet_position_look;

			variant(look, match: 14) => packet_look;

			variant(flying, match: 15) => packet_flying;

			variant(vehicle_move, match: 16) => packet_vehicle_move;

			variant(steer_boat, match: 17) => packet_steer_boat;

			variant(abilities, match: 18) => packet_abilities;

			variant(block_dig, match: 19) => packet_block_dig;

			variant(entity_action, match: 20) => packet_entity_action;

			variant(steer_vehicle, match: 21) => packet_steer_vehicle;

			variant(resource_pack_receive, match: 22) => packet_resource_pack_receive;

			variant(held_item_slot, match: 23) => packet_held_item_slot;

			variant(set_creative_slot, match: 24) => packet_set_creative_slot;

			variant(update_sign, match: 25) => packet_update_sign;

			variant(arm_animation, match: 26) => packet_arm_animation;

			variant(spectate, match: 27) => packet_spectate;

			variant(block_place, match: 28) => packet_block_place;

			variant(use_item, match: 29) => packet_use_item;

			default;
		};

		def(packet_abilities) => container {
			field(flags) => i8;

			field(flyingSpeed) => f32;

			field(walkingSpeed) => f32;
		};

		def(packet_arm_animation) => varint;

		def(packet_block_dig) => container {
			field(status) => varint;

			field(location) => position;

			field(face) => i8;
		};

		def(packet_block_place) => container {
			field(location) => position;

			field(direction) => varint;

			field(hand) => varint;

			field(cursorX) => i8;

			field(cursorY) => i8;

			field(cursorZ) => i8;
		};

		def(packet_chat) => string;

		def(packet_client_command) => union(Tag: varint) {
			variant(perform_respawn, match: 0);

			variant(request_stats, match: 1);

			variant(open_inventory_achievement, match: 2);

			default;
		};

		def(packet_close_window) => u8;

		def(packet_custom_payload) => container {
			field(channel) => string;

			field(data) => restBuffer;
		};

		def(packet_enchant_item) => container {
			field(windowId) => i8;

			field(enchantment) => i8;
		};

		def(packet_entity_action) => container {
			field(entityId) => varint;

			field(actionId) => union(Tag: varint) {
				variant(start_sneaking, match: 0);

				variant(stop_sneaking, match: 1);

				variant(stop_sleeping, match: 2);

				variant(start_sprinting, match: 3);

				variant(stop_sprinting, match: 4);

				variant(start_riding_jump, match: 5);

				variant(stop_riding_jump, match: 6);

				variant(open_inventory, match: 7);

				variant(start_fall_flying, match: 8);

				default;
			};

			field(jumpBoost) => varint;
		};

		def(packet_flying) => bool;

		def(packet_held_item_slot) => i16;

		def(packet_keep_alive) => varint;

		def(packet_look) => container {
			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_position) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(onGround) => bool;
		};

		def(packet_position_look) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_resource_pack_receive) => container {
			field(hash) => string;

			field(result) => varint;
		};

		def(packet_set_creative_slot) => container {
			field(slot) => i16;

			field(item) => slot;
		};

		def(packet_settings) => container {
			field(locale) => string;

			field(viewDistance) => i8;

			field(chatFlags) => varint;

			field(chatColors) => bool;

			field(skinParts) => u8;

			field(mainHand) => varint;
		};

		def(packet_spectate) => UUID;

		def(packet_steer_boat) => container {
			field(leftPaddle) => bool;

			field(rightPaddle) => bool;
		};

		def(packet_steer_vehicle) => container {
			field(sideways) => f32;

			field(forward) => f32;

			field(jump) => u8;
		};

		def(packet_tab_complete) => container {
			field(text) => string;

			field(assumeCommand) => bool;

			field(lookedAtBlock) => option => position;
		};

		def(packet_teleport_confirm) => varint;

		def(packet_transaction) => container {
			field(windowId) => i8;

			field(action) => i16;

			field(accepted) => bool;
		};

		def(packet_update_sign) => container {
			field(location) => position;

			field(text1) => string;

			field(text2) => string;

			field(text3) => string;

			field(text4) => string;
		};

		def(packet_use_entity) => container {
			field(target) => varint;

			field(mouse) => union(Tag: varint) {
				variant(v0, match: 0) => varint;

				variant(v2, match: 2) => container {
					field(x) => f32;

					field(y) => f32;

					field(z) => f32;

					field(hand) => varint;
				};

				default;
			};
		};

		def(packet_use_item) => varint;

		def(packet_vehicle_move) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;
		};

		def(packet_window_click) => container {
			field(windowId) => u8;

			field(slot) => i16;

			field(mouseButton) => i8;

			field(action) => i16;

			field(mode) => i8;

			field(item) => slot;
		};
	};
};

namespace(status) {
	namespace(toClient) {
		def(packet) => union(Tag: varint) {
			variant(server_info, match: 0) => packet_server_info;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_server_info) => string;
	};

	namespace(toServer) {
		def(packet) => union(Tag: varint) {
			variant(ping_start, match: 0) => packet_ping_start;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_ping_start) => container;
	};
};
