def(Slot) => union(Tag: varint) {
	variant(v0, match: 0) => void;

	default => container {
		field(itemId) => varint;

		field(addedComponentCount) => varint;

		field(removedComponentCount) => varint;

		field(components) => array(count: ../addedComponentCount) => SlotComponent;

		field(removeComponents) => array(count: ../removedComponentCount) => SlotComponentType;
	};
};

