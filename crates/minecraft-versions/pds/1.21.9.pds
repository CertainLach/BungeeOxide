	variant(custom_data, match: 0) => anonymousNbt;

	variant(max_stack_size, match: 1) => varint;

	variant(enchantments, match: 10) => array(Count: varint) => container {
		field(id) => varint;

		field(level) => varint;
	};

	variant(can_place_on, match: 11) => array(Count: varint) => ItemBlockPredicate;

	variant(can_break, match: 12) => array(Count: varint) => ItemBlockPredicate;

	variant(attribute_modifiers, match: 13) => array(Count: varint) => container {
		field(typeId) => varint;

		field(name) => string;

		field(value) => f64;

		field(operation) => union(Tag: varint) {
			variant(add, match: 0);

			variant(multiply_base, match: 1);

			variant(multiply_total, match: 2);

			default;
		};

		field(slot) => union(Tag: varint) {
			variant(any, match: 0);

			variant(main_hand, match: 1);

			variant(saddle, match: 10);

			variant(off_hand, match: 2);

