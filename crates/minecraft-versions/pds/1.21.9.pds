		def(packet_entity_action) => container {
			field(entityId) => varint;

			field(actionId) => union(Tag: varint) {
				variant(stop_sleeping, match: 0);

				variant(start_sprinting, match: 1);

				variant(stop_sprinting, match: 2);

				variant(start_riding_jump, match: 3);

				variant(stop_riding_jump, match: 4);

				variant(open_inventory, match: 5);

				variant(start_fall_flying, match: 6);

				default;
			};

			field(jumpBoost) => varint;
		};

		def(packet_flying) => MovementFlags;

		def(packet_generate_structure) => container {
			field(location) => position;

			field(levels) => varint;

			field(keepJigsaws) => bool;
		};

		def(packet_held_item_slot) => i16;

		def(packet_keep_alive) => i64;

		def(packet_lock_difficulty) => bool;

		def(packet_look) => container {
			field(yaw) => f32;

			field(pitch) => f32;

			field(flags) => MovementFlags;
		};

		def(packet_message_acknowledgement) => varint;

		def(packet_name_item) => string;

		def(packet_pick_item_from_block) => container {
			field(position) => position;

			field(includeData) => bool;
		};

		def(packet_pick_item_from_entity) => container {
			field(entityId) => varint;

			field(includeData) => bool;
		};

		def(packet_ping_request) => i64;

		def(packet_player_input)
		=> bitflags {
			flag(forward);

			flag(backward);

			flag(left);

			flag(right);

			flag(jump);

			flag(shift);

			flag(sprint);
		}
		=> u8;

		def(packet_player_loaded) => container;

		def(packet_pong) => i32;

		def(packet_position) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(flags) => MovementFlags;
		};

		def(packet_position_look) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;

			field(flags) => MovementFlags;
		};

		def(packet_query_block_nbt) => container {
			field(transactionId) => varint;

			field(location) => position;
		};

		def(packet_query_entity_nbt) => container {
			field(transactionId) => varint;

			field(entityId) => varint;
		};

		def(packet_recipe_book) => container {
			field(bookId) => varint;

			field(bookOpen) => bool;

			field(filterActive) => bool;
		};

		def(packet_resource_pack_receive) => container {
			field(uuid) => UUID;

			field(result) => varint;
		};

		def(packet_select_bundle_item) => container {
			field(slotId) => varint;

			field(selectedItemIndex) => varint;
		};

		def(packet_select_trade) => varint;

		def(packet_set_beacon_effect) => container {
			field(primary_effect) => option => varint;

			field(secondary_effect) => option => varint;
		};

		def(packet_set_creative_slot) => container {
			field(slot) => i16;

			field(item) => UntrustedSlot;
		};

		def(packet_set_difficulty) => union(Tag: varint) {
			variant(peaceful, match: 0);

			variant(easy, match: 1);

			variant(normal, match: 2);

			variant(hard, match: 3);

			default;
		};

		def(packet_set_slot_state) => container {
			field(slot_id) => varint;

			field(window_id) => ContainerID;

			field(state) => bool;
		};

		def(packet_set_test_block) => container {
			field(position) => position;

			field(mode) => varint;

			field(message) => string;
		};

		def(packet_spectate) => UUID;

		def(packet_steer_boat) => container {
			field(leftPaddle) => bool;

			field(rightPaddle) => bool;
		};

		def(packet_tab_complete) => container {
			field(transactionId) => varint;

			field(text) => string;
		};

		def(packet_teleport_confirm) => varint;

		def(packet_test_instance_block_action) => container {
			field(pos) => position;

			field(action) => varint;

			field(data) => container {
				field(test) => option => string;

				field(size) => vec3i;

				field(rotation) => varint;

				field(ignoreEntities) => bool;

				field(status) => varint;

				field(errorMessage) => option => anonymousNbt;
			};
		};

		def(packet_tick_end) => container;

		def(packet_update_command_block) => container {
			field(location) => position;

			field(command) => string;

			field(mode) => varint;

			field(flags) => u8;
		};

		def(packet_update_command_block_minecart) => container {
			field(entityId) => varint;

			field(command) => string;

			field(track_output) => bool;
		};

		def(packet_update_jigsaw_block) => container {
			field(location) => position;

			field(name) => string;

			field(target) => string;

			field(pool) => string;

			field(finalState) => string;

			field(jointType) => string;

			field(selection_priority) => varint;

			field(placement_priority) => varint;
		};

		def(packet_update_sign) => container {
			field(location) => position;

			field(isFrontText) => bool;

			field(text1) => string;

			field(text2) => string;

			field(text3) => string;

			field(text4) => string;
		};

		def(packet_update_structure_block) => container {
			field(location) => position;

			field(action) => varint;

			field(mode) => varint;

			field(name) => string;

			field(offset_x) => i8;

			field(offset_y) => i8;

			field(offset_z) => i8;

			field(size_x) => i8;

			field(size_y) => i8;

			field(size_z) => i8;

			field(mirror) => varint;

			field(rotation) => varint;

			field(metadata) => string;

			field(integrity) => f32;

			field(seed) => varint;

			field(flags) => u8;
		};

		def(packet_use_entity) => container {
			field(target) => varint;

			field(mouse) => union(Tag: varint) {
				variant(v0, match: 0) => varint;

				variant(v2, match: 2) => container {
					field(x) => f32;

					field(y) => f32;

					field(z) => f32;

					field(hand) => varint;
				};

				default;
			};

			field(sneaking) => bool;
		};

		def(packet_use_item) => container {
			field(hand) => varint;

			field(sequence) => varint;

			field(rotation) => vec2f;
		};

		def(packet_vehicle_move) => container {
			field(x) => f64;

			field(y) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_window_click) => container {
			field(windowId) => ContainerID;

			field(stateId) => varint;

			field(slot) => i16;

			field(mouseButton) => i8;

			field(mode) => varint;

			field(changedSlots) => array(Count: varint) => container {
				field(location) => i16;

				field(item) => option => HashedSlot;
			};

			field(cursorItem) => option => HashedSlot;
		};
	};
};

namespace(status) {
	namespace(toClient) {
		def(packet) => union(Tag: varint) {
			variant(server_info, match: 0) => packet_server_info;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_server_info) => string;
	};

	namespace(toServer) {
		def(packet) => union(Tag: varint) {
			variant(ping_start, match: 0) => packet_ping_start;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_ping_start) => container;
	};
};
