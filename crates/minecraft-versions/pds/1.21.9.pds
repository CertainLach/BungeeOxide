			variant(feet, match: 4);

			variant(legs, match: 5);

			variant(chest, match: 6);

			variant(head, match: 7);

			variant(armor, match: 8);

			variant(body, match: 9);

			default;
		};

		field(display) => union(Tag: varint) {
			variant(default, match: 0);

			variant(hidden, match: 1);

			variant(override, match: 2) => anonymousNbt;

			default;
		};
	};

	variant(custom_model_data, match: 14) => container {
		field(floats) => array(Count: varint) => f32;

		field(flags) => array(Count: varint) => bool;

		field(strings) => array(Count: varint) => string;

		field(colors) => array(Count: varint) => i32;
