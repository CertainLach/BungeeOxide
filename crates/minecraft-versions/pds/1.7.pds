			variant(login_start, match: 0) => packet_login_start;

			variant(encryption_begin, match: 1) => packet_encryption_begin;

			default;
		};

		def(packet_encryption_begin) => container {
			field(sharedSecret) => buffer(Count: i16);

			field(verifyToken) => buffer(Count: i16);
		};

		def(packet_login_start) => string;
	};
};

