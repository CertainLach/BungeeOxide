};

def(entityMetadata) => entityMetadataLoop(end: u8(127)) => container {
	field(ANON) => bitfield {
		field(type, signed: false, size: 3);

		field(key, signed: false, size: 5);
	};

	field(value) => entityMetadataItem(compareTo: ../ANON/type);
};

def(entityMetadataItem) {
	argument(compareTo) => u8;
}
=> union(tag: ./$compareTo) {
	variant(v0, match: 0) => i8;

	variant(v1, match: 1) => i16;

	variant(v2, match: 2) => i32;

	variant(v3, match: 3) => f32;

	variant(v4, match: 4) => string;

	variant(v5, match: 5) => slot;

	variant(v6, match: 6) => container {
		field(x) => i32;

		field(y) => i32;

		field(z) => i32;
	};

	variant(v7, match: 7) => container {
		field(pitch) => f32;

		field(yaw) => f32;

		field(roll) => f32;
	};

	default;
};

@specializer entityMetadataLoop
def_native(entityMetadataLoop) {
	argument(end) => End;

	type(End);

	type(Value);

	body;
};

