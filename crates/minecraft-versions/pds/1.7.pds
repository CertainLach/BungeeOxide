					field(operation) => i8;
				};
			};
		};

		def(packet_update_health) => container {
			field(health) => f32;

			field(food) => i16;

			field(foodSaturation) => f32;
		};

		def(packet_update_sign) => container {
			field(location) => position_isi;

			field(text1) => string;

			field(text2) => string;

			field(text3) => string;

			field(text4) => string;
		};

		def(packet_update_time) => container {
			field(age) => i64;

			field(time) => i64;
		};

		def(packet_window_items) => container {
			field(windowId) => u8;

			field(items) => array(Count: i16) => slot;
		};

		def(packet_world_event) => container {
			field(effectId) => i32;

			field(location) => position_ibi;

			field(data) => i32;

			field(global) => bool;
		};

		def(packet_world_particles) => container {
			field(particleName) => string;

			field(x) => f32;

			field(y) => f32;

			field(z) => f32;

			field(offsetX) => f32;

			field(offsetY) => f32;

			field(offsetZ) => f32;

			field(particleData) => f32;

			field(particles) => i32;
		};
	};

	namespace(toServer) {
		def(packet) => union(Tag: varint) {
			variant(keep_alive, match: 0) => packet_keep_alive;

			variant(chat, match: 1) => packet_chat;

			variant(use_entity, match: 2) => packet_use_entity;

			variant(flying, match: 3) => packet_flying;

			variant(position, match: 4) => packet_position;

			variant(look, match: 5) => packet_look;

			variant(position_look, match: 6) => packet_position_look;

			variant(block_dig, match: 7) => packet_block_dig;

			variant(block_place, match: 8) => packet_block_place;

			variant(held_item_slot, match: 9) => packet_held_item_slot;

			variant(arm_animation, match: 10) => packet_arm_animation;

			variant(entity_action, match: 11) => packet_entity_action;

			variant(steer_vehicle, match: 12) => packet_steer_vehicle;

			variant(close_window, match: 13) => packet_close_window;

			variant(window_click, match: 14) => packet_window_click;

			variant(transaction, match: 15) => packet_transaction;

			variant(set_creative_slot, match: 16) => packet_set_creative_slot;

			variant(enchant_item, match: 17) => packet_enchant_item;

			variant(update_sign, match: 18) => packet_update_sign;

			variant(abilities, match: 19) => packet_abilities;

			variant(tab_complete, match: 20) => packet_tab_complete;

			variant(settings, match: 21) => packet_settings;

			variant(client_command, match: 22) => packet_client_command;

			variant(custom_payload, match: 23) => packet_custom_payload;

			default;
		};

		def(packet_abilities) => container {
			field(flags) => i8;

			field(flyingSpeed) => f32;

			field(walkingSpeed) => f32;
		};

		def(packet_arm_animation) => container {
			field(entityId) => i32;

			field(animation) => i8;
		};

		def(packet_block_dig) => container {
			field(status) => i8;

			field(location) => position_ibi;

			field(face) => i8;
		};

		def(packet_block_place) => container {
			field(location) => position_ibi;

			field(direction) => i8;

			field(heldItem) => slot;

			field(cursorX) => i8;

			field(cursorY) => i8;

			field(cursorZ) => i8;
		};

		def(packet_chat) => string;

		def(packet_client_command) => union(Tag: i8) {
			variant(perform_respawn, match: 0);

			variant(request_stats, match: 1);

			variant(open_inventory_achievement, match: 2);

			default;
		};

		def(packet_close_window) => u8;

		def(packet_custom_payload) => container {
			field(channel) => string;

			field(data) => buffer(Count: i16);
		};

		def(packet_enchant_item) => container {
			field(windowId) => i8;

			field(enchantment) => i8;
		};

		def(packet_entity_action) => container {
			field(entityId) => i32;

			field(actionId) => union(Tag: i8) {
				variant(start_sneaking, match: 1);

				variant(stop_sneaking, match: 2);

				variant(stop_sleeping, match: 3);

				variant(start_sprinting, match: 4);

				variant(stop_sprinting, match: 5);

				variant(start_riding_jump, match: 6);

				variant(open_inventory, match: 7);

				default;
			};

			field(jumpBoost) => i32;
		};

		def(packet_flying) => bool;

		def(packet_held_item_slot) => i16;

		def(packet_keep_alive) => i32;

		def(packet_look) => container {
			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_position) => container {
			field(x) => f64;

			field(y) => f64;

			field(stance) => f64;

			field(z) => f64;

			field(onGround) => bool;
		};

		def(packet_position_look) => container {
			field(x) => f64;

			field(y) => f64;

			field(stance) => f64;

			field(z) => f64;

			field(yaw) => f32;

			field(pitch) => f32;

			field(onGround) => bool;
		};

		def(packet_set_creative_slot) => container {
			field(slot) => i16;

			field(item) => slot;
		};

		def(packet_settings) => container {
			field(locale) => string;

			field(viewDistance) => i8;

			field(chatFlags) => i8;

			field(chatColors) => bool;

			field(difficulty) => u8;

			field(showCape) => bool;
		};

		def(packet_steer_vehicle) => container {
			field(sideways) => f32;

			field(forward) => f32;

			field(jump) => bool;

			field(unmount) => bool;
		};

		def(packet_tab_complete) => string;

		def(packet_transaction) => container {
			field(windowId) => i8;

			field(action) => i16;

			field(accepted) => bool;
		};

		def(packet_update_sign) => container {
			field(location) => position_isi;

			field(text1) => string;

			field(text2) => string;

			field(text3) => string;

			field(text4) => string;
		};

		def(packet_use_entity) => container {
			field(target) => i32;

			field(mouse) => union(Tag: i8) {
				variant(v2, match: 2) => container {
					field(x) => f32;

					field(y) => f32;

					field(z) => f32;
				};

				default;
			};
		};

		def(packet_window_click) => container {
			field(windowId) => i8;

			field(slot) => i16;

			field(mouseButton) => i8;

			field(action) => i16;

			field(mode) => i8;

			field(item) => slot;
		};
	};
};

namespace(status) {
	namespace(toClient) {
		def(packet) => union(Tag: varint) {
			variant(server_info, match: 0) => packet_server_info;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_server_info) => string;
	};

	namespace(toServer) {
		def(packet) => union(Tag: varint) {
			variant(ping_start, match: 0) => packet_ping_start;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_ping_start) => container;
	};
};
