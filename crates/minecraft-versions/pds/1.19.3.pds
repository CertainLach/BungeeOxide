	namespace(toServer) {
		def(packet) => union(Tag: varint) {
			variant(teleport_confirm, match: 0) => packet_teleport_confirm;

			variant(query_block_nbt, match: 1) => packet_query_block_nbt;

			variant(set_difficulty, match: 2) => packet_set_difficulty;

			variant(message_acknowledgement, match: 3) => packet_message_acknowledgement;

			variant(chat_command, match: 4) => packet_chat_command;

			variant(chat_message, match: 5) => packet_chat_message;

			variant(client_command, match: 6) => packet_client_command;

			variant(settings, match: 7) => packet_settings;

			variant(tab_complete, match: 8) => packet_tab_complete;

			variant(enchant_item, match: 9) => packet_enchant_item;

			variant(window_click, match: 10) => packet_window_click;

			variant(close_window, match: 11) => packet_close_window;

