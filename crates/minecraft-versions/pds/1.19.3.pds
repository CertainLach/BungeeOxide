					match: "minecraft:crafting_special_firework_rocket"
				)
				=> minecraft_simple_recipe_format;

				variant(
					minecraft_crafting_special_firework_star,
					match: "minecraft:crafting_special_firework_star"
				)
				=> minecraft_simple_recipe_format;

				variant(
					minecraft_crafting_special_firework_star_fade,
					match: "minecraft:crafting_special_firework_star_fade"
				)
				=> minecraft_simple_recipe_format;

				variant(
					minecraft_crafting_special_mapcloning,
					match: "minecraft:crafting_special_mapcloning"
				)
				=> minecraft_simple_recipe_format;

				variant(
					minecraft_crafting_special_mapextending,
					match: "minecraft:crafting_special_mapextending"
				)
				=> minecraft_simple_recipe_format;

				variant(
					minecraft_crafting_special_repairitem,
					match: "minecraft:crafting_special_repairitem"
				)
				=> minecraft_simple_recipe_format;

				variant(
					minecraft_crafting_special_shielddecoration,
					match: "minecraft:crafting_special_shielddecoration"
				)
				=> minecraft_simple_recipe_format;

				variant(
					minecraft_crafting_special_shulkerboxcoloring,
					match: "minecraft:crafting_special_shulkerboxcoloring"
				)
				=> minecraft_simple_recipe_format;

				variant(
