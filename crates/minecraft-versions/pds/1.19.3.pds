					match: "minecraft:crafting_special_tippedarrow"
				)
				=> minecraft_simple_recipe_format;

				variant(minecraft_smelting, match: "minecraft:smelting") => minecraft_smelting_format;

				variant(minecraft_smithing, match: "minecraft:smithing") => container {
