namespace(status) {
	namespace(toClient) {
		def(packet) => union(Tag: varint) {
			variant(server_info, match: 0) => packet_server_info;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_server_info) => string;
	};

	namespace(toServer) {
		def(packet) => union(Tag: varint) {
			variant(ping_start, match: 0) => packet_ping_start;

			variant(ping, match: 1) => packet_ping;

			default;
		};

		def(packet_ping) => i64;

		def(packet_ping_start) => container;
	};
};
