namespace(play) {
	namespace(toClient) {
		updated(PositionUpdateRelatives) {
			added(dx, up: ./x);
			added(dy, up: ./y);
			added(dz, up: ./z);
			added(yawDelta, up: false);
		};

		updated(SpawnInfo) {
			added(seaLevel, up: 63);
		};

		updated(packet) {
			converted(close_window);
			added(move_minecart, down: custom(tricky_move_minecart_down_1_21_1));
			added(player_rotation, down: custom(tricky_player_rotation_down_1_21_1));
			added(recipe_book_add, down: custom(tricky_recipe_book_add_down_1_21_1));
			added(recipe_book_remove, down: custom(tricky_recipe_book_remove_down_1_21_1));
			added(recipe_book_settings, down: custom(tricky_recipe_book_settings_down_1_21_1));
			added(set_cursor_item, down: custom(tricky_set_cursor_item_down_1_21_1));
			added(set_player_inventory, down: custom(tricky_set_player_inventory_down_1_21_1));
			added(sync_entity_position, down: custom(tricky_sync_position_down_1_21_1));
			removed(unlock_recipes, up: drop);
			converted(declare_recipes, up: custom(tricky_declare_recipes_1_21_3), down: custom(tricky_declare_recipes_down_1_21_1));
			converted(tags, up: custom(tricky_play_tags_1_21_3), down: custom(tricky_play_tags_down_1_21_1));
			converted(set_slot, up: custom(tricky_set_slot_1_21_3), down: custom(tricky_set_slot_down_1_21_1));
			converted(window_items, up: custom(tricky_window_items_1_21_3), down: custom(tricky_window_items_down_1_21_1));
			converted(entity_teleport, up: custom(tricky_teleport_1_21_3), down: custom(tricky_teleport_down_1_21_1));
			converted(explosion, up: custom(tricky_explosion_1_21_3), down: custom(tricky_explosion_down_1_21_1));
			converted(craft_recipe_response, up: drop, down: drop);
			converted(entity_destroy, up: custom(tricky_destroy_1_21_3), down: custom(tricky_destroy_down_1_21_1));
			converted(map_chunk, up: custom(tricky_map_chunk_1_21_3));
			converted(bundle_delimiter, up: custom(tricky_bundle_1_21_3));
			converted(position, down: custom(tricky_position_down_1_21_1));
			converted(spawn_entity, down: custom(tricky_spawn_entity_down_1_21_1));
		};

		updated(packet_craft_progress_bar) {
			converted(windowId);
		};

		updated(packet_entity_update_attributes) {
			updated(properties) {
				updated(items) {
					updated(key) {
						renamed(generic_burning_time, to: burning_time);
						renamed(generic_explosion_knockback_resistance, to: explosion_knockback_resistance);
						renamed(player_mining_efficiency, to: mining_efficiency);
						renamed(generic_movement_efficiency, to: movement_efficiency);
						renamed(generic_oxygen_bonus, to: oxygen_bonus);
						renamed(player_sneaking_speed, to: sneaking_speed);
						renamed(player_submerged_mining_speed, to: submerged_mining_speed);
						renamed(player_sweeping_damage_ratio, to: sweeping_damage_ratio);
						renamed(generic_water_movement_efficiency, to: water_movement_efficiency);
						added(tempt_range, down: drop);
					};
				};
			};
		};

		updated(packet_open_horse_window) {
			converted(windowId);
		};

		updated(packet_player_info) {
			updated(action) {
				added(update_list_order, up: false);
			};
			updated(data) {
				updated(items) {
					added(listPriority, up: custom(tricky_list_priority_1_21_3));
				};
			};
		};

		updated(packet_position) {
			added(dx, up: 0.0);
			added(dy, up: 0.0);
			added(dz, up: 0.0);
		};

		updated(packet_set_cooldown) {
			added(cooldownGroup, up: custom(tricky_cooldown_group_1_21_3));
			removed(itemID, down: custom(tricky_cooldown_item_down_1_21_1));
		};

		updated(packet_trade_list) {
			converted(windowId);
			updated(trades) {
				updated(items) {
					updated(inputItem1) {
						converted(itemId, up: custom(tricky_trade_item_1_21_3), down: custom(tricky_trade_item_down_1_21_1));
						converted(addedComponentCount, down: custom(tricky_trade_components_down_1_21_1));
					};
					updated(inputItem2) {
						updated(value) {
							converted(itemId, up: custom(tricky_trade_item2_1_21_3), down: custom(tricky_trade_item2_down_1_21_1));
							converted(addedComponentCount, down: custom(tricky_trade_components2_down_1_21_1));
						};
					};
				};
			};
		};

		updated(packet_update_time) {
			added(tickDayTime, up: custom(tricky_tick_day_time_1_21_3));
			converted(time, up: custom(tricky_day_time_1_21_3), down: custom(tricky_day_time_down_1_21_1));
		};

		updated(packet_entity_metadata) {
			converted(entityId, up: custom(tricky_meta_entity_1_21_3), down: custom(tricky_meta_entity_down_1_21_1));
		};

		updated(packet_spawn_entity) {
			converted(type, up: custom(tricky_entity_type_1_21_3));
			converted(objectData, up: custom(tricky_object_data_1_21_3));
		};

		updated(packet_block_change) {
			converted(type, up: custom(tricky_block_change_1_21_3), down: custom(tricky_block_change_down_1_21_1));
		};

		updated(packet_multi_block_change) {
			converted(records, up: custom(tricky_multi_block_1_21_3), down: custom(tricky_multi_block_down_1_21_1));
		};

		updated(packet_map_chunk) {
			converted(chunkData, down: custom(tricky_chunk_down_1_21_1));
		};

		updated(packet_respawn) {
			converted(copyMetadata, up: custom(tricky_respawn_1_21_3));
		};

		updated(packet_unload_chunk, up: custom(tricky_unload_chunk_1_21_3));

		updated(packet_tile_entity_data) {
			converted(action, up: custom(tricky_tile_entity_1_21_3), down: custom(tricky_tile_entity_down_1_21_1));
		};

		updated(packet_world_event) {
			converted(data, up: custom(tricky_world_event_1_21_3), down: custom(tricky_world_event_down_1_21_1));
		};

		updated(packet_login) {
			converted(entityId, up: custom(tricky_login_entity_1_21_3), down: custom(tricky_login_entity_down_1_21_1));
		};

		updated(packet_set_passengers, up: custom(tricky_passengers_1_21_3), down: custom(tricky_passengers_down_1_21_1));
	};
};

